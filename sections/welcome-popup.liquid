{%- comment -%}
  MIHAILIUC — Welcome popup (reducere de bun venit)
  Se randează în overlay-group. Afișare după un delay, o singură dată per vizitator
  (localStorage). După abonare afișează codul + link cu aplicare automată.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign code = s.discount_code | strip | upcase
  comment
    IE (market ireland): UI labels in English; branch on market, never on locale 'en'. Code comes from overlay-group.context.ireland.json.
  endcomment
  assign wp_ie = false
  if localization.market.handle == 'ireland'
    assign wp_ie = true
  endif
  assign wp_es = false
  if localization.market.handle == 'spania'
    assign wp_es = true
  endif
  if s.redirect_url != blank
    assign redirect_path = s.redirect_url
  else
    assign redirect_path = request.path
  endif
  assign redirect_enc = redirect_path | url_encode
  assign apply_url = '/discount/' | append: code | append: '?redirect=' | append: redirect_enc
-%}

{%- if s.enabled -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

<style>
  #MhlWelcomePopup {
    --wp-cream: #f7f1e6;
    --wp-cream-2: #efe5d4;
    --wp-ink: #2a1a12;
    --wp-ink-soft: #5c463a;
    --wp-rust: #9a4a2a;
    --wp-rust-dark: #7a3620;
    --wp-wine: #5e2a26;
    --wp-gold: #c9a46b;
    --wp-radius: 22px;
    position: fixed;
    inset: 0;
    z-index: 100000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: inherit;
  }
  #MhlWelcomePopup.is-open { display: flex; }

  .mhl-wp__backdrop {
    position: absolute; inset: 0;
    background: radial-gradient(120% 120% at 50% 100%, rgba(94,42,38,.55), rgba(24,14,10,.72));
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity .5s ease;
  }
  #MhlWelcomePopup.is-visible .mhl-wp__backdrop { opacity: 1; }

  .mhl-wp__card {
    position: relative;
    width: min(920px, 100%);
    max-height: calc(100vh - 40px);
    overflow: auto;
    display: grid;
    grid-template-columns: 5fr 6fr;
    background: var(--wp-cream);
    color: var(--wp-ink);
    border-radius: var(--wp-radius);
    box-shadow: 0 40px 90px rgba(20,10,6,.45), 0 0 0 1px rgba(201,164,107,.35);
    transform: translateY(18px) scale(.98);
    opacity: 0;
    transition: transform .6s cubic-bezier(.2,.8,.2,1), opacity .5s ease;
  }
  #MhlWelcomePopup.is-visible .mhl-wp__card { transform: none; opacity: 1; }

  .mhl-wp__visual {
    position: relative;
    min-height: 420px;
    background: linear-gradient(160deg, #7a3620 0%, #5e2a26 55%, #3d1c17 100%);
    overflow: hidden;
    border-radius: var(--wp-radius) 0 0 var(--wp-radius);
  }
  .mhl-wp__visual img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
  }
  .mhl-wp__visual::after {
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(42,26,18,0) 45%, rgba(42,26,18,.55) 100%);
    pointer-events: none;
  }
  .mhl-wp__leaf {
    position: absolute;
    color: rgba(201,164,107,.28);
    pointer-events: none;
  }
  .mhl-wp__leaf--1 { width: 210px; right: -50px; top: -30px; transform: rotate(25deg); }
  .mhl-wp__leaf--2 { width: 150px; left: -40px; bottom: 40px; transform: rotate(-140deg); }
  .mhl-wp__big {
    position: absolute; left: 32px; bottom: 30px; z-index: 2;
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--wp-cream);
    line-height: .9;
  }
  .mhl-wp__big strong {
    display: block;
    font-size: clamp(88px, 12vw, 128px);
    font-weight: 500;
    letter-spacing: -.02em;
  }
  .mhl-wp__big span {
    display: block;
    font-size: 15px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--wp-gold);
    margin-top: 10px;
    font-family: inherit;
  }

  .mhl-wp__content {
    padding: 52px 52px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .mhl-wp__eyebrow {
    font-size: 11px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--wp-rust);
    margin: 0 0 16px;
    display: flex; align-items: center; gap: 14px;
  }
  .mhl-wp__eyebrow::before {
    content: ""; width: 28px; height: 1px; background: var(--wp-gold);
  }
  .mhl-wp__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(30px, 3.2vw, 40px);
    font-weight: 500;
    line-height: 1.12;
    margin: 0 0 16px;
    color: var(--wp-ink);
    letter-spacing: -.01em;
  }
  .mhl-wp__text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--wp-ink-soft);
    margin: 0 0 26px;
  }
  .mhl-wp__text p { margin: 0; }

  .mhl-wp__form { margin: 0; }
  .mhl-wp__field {
    display: flex;
    background: #fff;
    border: 1px solid rgba(42,26,18,.14);
    border-radius: 999px;
    padding: 5px 5px 5px 20px;
    transition: border-color .2s, box-shadow .2s;
  }
  .mhl-wp__field:focus-within {
    border-color: var(--wp-gold);
    box-shadow: 0 0 0 4px rgba(201,164,107,.18);
  }
  .mhl-wp__field input {
    flex: 1; min-width: 0;
    border: 0; outline: 0; background: transparent;
    font-size: 15px; color: var(--wp-ink);
    font-family: inherit;
  }
  .mhl-wp__field input::placeholder { color: #9a8a7c; }
  .mhl-wp__btn {
    appearance: none; border: 0; cursor: pointer;
    background: var(--wp-rust);
    color: var(--wp-cream);
    font-family: inherit;
    font-size: 13px; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase;
    padding: 15px 22px;
    border-radius: 999px;
    white-space: nowrap;
    transition: background .2s, transform .2s;
  }
  .mhl-wp__btn:hover { background: var(--wp-rust-dark); transform: translateY(-1px); }
  .mhl-wp__error {
    margin: 10px 0 0; font-size: 13px; color: #a2372a;
  }
  .mhl-wp__note {
    font-size: 12px; line-height: 1.6; color: #8a776a;
    margin: 16px 0 0;
  }
  .mhl-wp__decline {
    display: inline-block;
    margin-top: 22px;
    background: none; border: 0; padding: 0; cursor: pointer;
    font-family: inherit; font-size: 12px; letter-spacing: .04em;
    color: #8a776a; text-decoration: underline; text-underline-offset: 3px;
  }
  .mhl-wp__decline:hover { color: var(--wp-ink); }

  /* Success state */
  .mhl-wp__code {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    border: 1px dashed var(--wp-gold);
    background: var(--wp-cream-2);
    border-radius: 14px;
    padding: 16px 20px;
    margin: 6px 0 18px;
  }
  .mhl-wp__code strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 30px; letter-spacing: .12em; font-weight: 600;
    color: var(--wp-wine);
  }
  .mhl-wp__copy {
    background: none; border: 1px solid rgba(42,26,18,.2); border-radius: 999px;
    padding: 8px 14px; cursor: pointer; font-family: inherit;
    font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--wp-ink);
  }
  .mhl-wp__copy:hover { border-color: var(--wp-ink); }
  .mhl-wp__apply {
    display: block; width: 100%; text-align: center; text-decoration: none;
    box-sizing: border-box;
  }

  .mhl-wp__close {
    position: absolute; top: 14px; right: 14px; z-index: 3;
    width: 40px; height: 40px; border-radius: 50%;
    border: 0; cursor: pointer;
    background: rgba(247,241,230,.9);
    color: var(--wp-ink);
    display: grid; place-items: center;
    transition: background .2s, transform .2s;
  }
  .mhl-wp__close:hover { background: #fff; transform: rotate(90deg); }
  .mhl-wp__close svg { width: 14px; height: 14px; }

  @media (max-width: 820px) {
    #MhlWelcomePopup { padding: 16px; align-items: center; }
    .mhl-wp__card { grid-template-columns: 1fr; max-height: calc(100dvh - 32px); }
    .mhl-wp__visual { min-height: 200px; border-radius: var(--wp-radius) var(--wp-radius) 0 0; }
    .mhl-wp__leaf { color: rgba(201,164,107,.18); }
    .mhl-wp__leaf--1 { width: 120px; right: 16px; top: -18px; transform: rotate(28deg); }
    .mhl-wp__leaf--2 { width: 80px; left: auto; right: 120px; bottom: -14px; transform: rotate(-150deg); }
    .mhl-wp__big { left: 26px; bottom: 24px; }
    .mhl-wp__big strong { font-size: 68px; }
    .mhl-wp__big span { font-size: 12px; letter-spacing: .26em; margin-top: 6px; }
    .mhl-wp__content { padding: 28px 24px 26px; }
    .mhl-wp__field { flex-direction: column; border-radius: 18px; padding: 6px; gap: 6px; }
    .mhl-wp__field input { padding: 12px 14px; }
    .mhl-wp__btn { width: 100%; }
  }
</style>

<div
  id="MhlWelcomePopup"
  data-delay="{{ s.delay | default: 10 }}"
  data-hide-days="{{ s.hide_days | default: 14 }}"
  data-code="{{ code }}"
  role="dialog"
  aria-modal="true"
  aria-labelledby="MhlWelcomeHeading"
  {{ section.shopify_attributes }}
>
  <div class="mhl-wp__backdrop" data-wp-close></div>

  <div class="mhl-wp__card">
    <button type="button" class="mhl-wp__close" aria-label="{% if wp_ie %}Close{% elsif wp_es %}Cerrar{% elsif request.locale.iso_code == 'de' %}Schließen{% elsif request.locale.iso_code == 'pl' %}Zamknij{% else %}Închide{% endif %}" data-wp-close>
      <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 1l12 12M13 1L1 13"/></svg>
    </button>

    <div class="mhl-wp__visual" aria-hidden="true">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        <svg class="mhl-wp__leaf mhl-wp__leaf--1" viewBox="0 0 100 160" fill="currentColor"><path d="M50 2c30 30 46 62 46 92 0 34-22 60-46 64C26 154 4 128 4 94 4 64 20 32 50 2zm0 22c-20 26-32 50-32 70 0 26 14 46 32 50 18-4 32-24 32-50 0-20-12-44-32-70z"/><path d="M48 24h4v130h-4z"/></svg>
        <svg class="mhl-wp__leaf mhl-wp__leaf--2" viewBox="0 0 100 160" fill="currentColor"><path d="M50 2c30 30 46 62 46 92 0 34-22 60-46 64C26 154 4 128 4 94 4 64 20 32 50 2zm0 22c-20 26-32 50-32 70 0 26 14 46 32 50 18-4 32-24 32-50 0-20-12-44-32-70z"/><path d="M48 24h4v130h-4z"/></svg>
      {%- endif -%}
      <div class="mhl-wp__big">
        <strong>{{ s.discount_label | default: '-15%' }}</strong>
        <span>{% if wp_ie %}{{ s.discount_sub | default: 'on your first order' }}{% elsif wp_es %}{{ s.discount_sub | default: 'en tu primer pedido' }}{% else %}{{ s.discount_sub | default: 'la prima comandă' }}{% endif %}</span>
      </div>
    </div>

    <div class="mhl-wp__content">
      {%- form 'customer', class: 'mhl-wp__form', id: 'MhlWelcomeForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="mhl-wp__eyebrow">{{ s.success_eyebrow }}</p>
          <h2 class="mhl-wp__heading" id="MhlWelcomeHeading">{{ s.success_heading }}</h2>
          <div class="mhl-wp__text">{{ s.success_text }}</div>

          <div class="mhl-wp__code">
            <strong id="MhlWelcomeCode">{{ code }}</strong>
            <button type="button" class="mhl-wp__copy" data-wp-copy>{% if wp_ie %}Copy{% elsif wp_es %}Copiar{% elsif request.locale.iso_code == 'de' %}Kopieren{% elsif request.locale.iso_code == 'pl' %}Kopiuj{% else %}Copiază{% endif %}</button>
          </div>

          <a class="mhl-wp__btn mhl-wp__apply" href="{{ apply_url }}" data-wp-apply data-fixed-redirect="{% if s.redirect_url != blank %}true{% else %}false{% endif %}">{{ s.success_button }}</a>
          <p class="mhl-wp__note">{{ s.success_note }}</p>
        {%- else -%}
          <p class="mhl-wp__eyebrow">{{ s.eyebrow }}</p>
          <h2 class="mhl-wp__heading" id="MhlWelcomeHeading">{{ s.heading }}</h2>
          <div class="mhl-wp__text">{{ s.text }}</div>

          <input type="hidden" name="contact[tags]" value="newsletter,welcome-popup,{{ code }}">
          <label class="mhl-wp__field">
            <span class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">E-mail</span>
            <input type="email" name="contact[email]" placeholder="{{ s.placeholder }}" autocomplete="email" required>
            <button type="submit" class="mhl-wp__btn">{{ s.button }}</button>
          </label>
          {%- if form.errors -%}
            <p class="mhl-wp__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <p class="mhl-wp__note">{{ s.note }}</p>
          <button type="button" class="mhl-wp__decline" data-wp-close>{{ s.decline }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('MhlWelcomePopup');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    var KEY = 'mhl_welcome_popup';
    var delay = parseInt(root.dataset.delay, 10) || 0;
    var hideDays = parseInt(root.dataset.hideDays, 10) || 14;
    var posted = !!root.querySelector('[data-wp-copy]');
    var hasErrors = !!root.querySelector('.mhl-wp__error');
    var designMode = !!(window.Shopify && window.Shopify.designMode);

    function read() {
      try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; }
    }
    function write(v) {
      try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {}
    }

    function open() {
      root.classList.add('is-open');
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { root.classList.add('is-visible'); });
      });
      document.documentElement.style.overflow = 'hidden';
      var input = root.querySelector('input[type="email"]');
      if (input && !posted) setTimeout(function () { input.focus({ preventScroll: true }); }, 500);
    }
    function close(remember) {
      root.classList.remove('is-visible');
      document.documentElement.style.overflow = '';
      setTimeout(function () { root.classList.remove('is-open'); }, 450);
      if (remember && !posted) write({ state: 'dismissed', at: Date.now() });
    }

    root.querySelectorAll('[data-wp-close]').forEach(function (el) {
      el.addEventListener('click', function () { close(true); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && root.classList.contains('is-open')) close(true);
    });

    var copyBtn = root.querySelector('[data-wp-copy]');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var code = root.dataset.code;
        if (navigator.clipboard) navigator.clipboard.writeText(code);
        var lng = (document.documentElement.lang || '').slice(0, 2);
        var ie = {{ wp_ie | json }};
        var es = {{ wp_es | json }};
        copyBtn.textContent = ie ? 'Copied' : es ? 'Copiado' : lng === 'de' ? 'Kopiert' : lng === 'pl' ? 'Skopiowano' : 'Copiat';
        setTimeout(function () { copyBtn.textContent = ie ? 'Copy' : es ? 'Copiar' : lng === 'de' ? 'Kopieren' : lng === 'pl' ? 'Kopiuj' : 'Copiază'; }, 2000);
      });
    }

    // Linkul de aplicare a codului trimite vizitatorul înapoi pe pagina curentă.
    var applyBtn = root.querySelector('[data-wp-apply]');
    if (applyBtn && applyBtn.dataset.fixedRedirect !== 'true') {
      var back = location.pathname + location.search.replace(/[?&]customer_posted=[^&]*/, '').replace(/^&/, '?');
      applyBtn.href = '/discount/' + encodeURIComponent(root.dataset.code) + '?redirect=' + encodeURIComponent(back);
    }

    // După abonare: afișăm imediat starea de succes și nu mai deranjăm vizitatorul.
    if (posted) {
      write({ state: 'subscribed', at: Date.now() });
      open();
      if (history.replaceState) {
        var u = new URL(location.href);
        u.searchParams.delete('customer_posted');
        u.hash = '';
        history.replaceState(null, '', u.toString());
      }
      return;
    }
    if (hasErrors) { open(); return; }

    if (designMode) {
      document.addEventListener('shopify:section:select', function (e) {
        if (e.target && e.target.contains(root)) open();
      });
      document.addEventListener('shopify:section:deselect', function (e) {
        if (e.target && e.target.contains(root)) close(false);
      });
      return;
    }

    var saved = read();
    if (saved) {
      if (saved.state === 'subscribed') return;
      if (saved.state === 'dismissed' && Date.now() - saved.at < hideDays * 86400000) return;
    }
    setTimeout(open, delay * 1000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Popup bun venit (-15%)",
  "tag": "aside",
  "enabled_on": { "groups": ["aside"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Activează popup-ul", "default": true },
    { "type": "range", "id": "delay", "label": "Apare după (secunde)", "min": 0, "max": 60, "step": 1, "default": 10 },
    { "type": "range", "id": "hide_days", "label": "Nu reafișa după închidere (zile)", "min": 1, "max": 90, "step": 1, "default": 14 },
    { "type": "text", "id": "discount_code", "label": "Cod de reducere", "default": "BUNVENIT15" },
    { "type": "url", "id": "redirect_url", "label": "Pagina după aplicarea codului", "info": "Lasă gol pentru a reveni pe pagina unde era vizitatorul." },
    { "type": "header", "content": "Vizual" },
    { "type": "image_picker", "id": "image", "label": "Imagine (opțional)", "info": "Portret, min. 800×1000 px. Fără imagine se afișează fundalul de toamnă." },
    { "type": "text", "id": "discount_label", "label": "Text mare", "default": "-15%" },
    { "type": "text", "id": "discount_sub", "label": "Text mic", "default": "la prima comandă" },
    { "type": "header", "content": "Înainte de abonare" },
    { "type": "text", "id": "eyebrow", "label": "Supratitlu", "default": "Bine ai venit" },
    { "type": "text", "id": "heading", "label": "Titlu", "default": "Un început frumos merită un gest pe măsură." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Abonează-te la noutățile MIHAILIUC și primești 15% reducere la prima comandă. Codul îl primești pe e-mail, gata de folosit.</p>" },
    { "type": "text", "id": "placeholder", "label": "Placeholder e-mail", "default": "Adresa ta de e-mail" },
    { "type": "text", "id": "button", "label": "Buton", "default": "Primesc reducerea" },
    { "type": "text", "id": "note", "label": "Notă", "default": "Codul și linkul ajung pe e-mail imediat după abonare. Te poți dezabona oricând." },
    { "type": "text", "id": "decline", "label": "Text refuz", "default": "Nu acum, mulțumesc" },
    { "type": "header", "content": "După abonare" },
    { "type": "text", "id": "success_eyebrow", "label": "Supratitlu", "default": "Abonare confirmată" },
    { "type": "text", "id": "success_heading", "label": "Titlu", "default": "Mulțumim. Reducerea ta este pregătită." },
    { "type": "richtext", "id": "success_text", "label": "Text", "default": "<p>Ți-am trimis codul și linkul pe e-mail, ca să le ai la îndemână oricând. Îl poți folosi și chiar acum:</p>" },
    { "type": "text", "id": "success_button", "label": "Buton", "default": "Aplică reducerea și descoperă colecția" },
    { "type": "text", "id": "success_note", "label": "Notă", "default": "Reducerea se aplică automat la finalizarea comenzii." }
  ],
  "presets": [
    { "name": "Popup bun venit (-15%)", "category": "Overlay" }
  ]
}
{% endschema %}
