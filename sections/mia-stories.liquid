{%- comment -%}
  MIA — Povești (Instagram highlight „Recenzii”), cu viewer fullscreen în stil Instagram.
  Media sunt în Shopify Files: mia-story-000.jpg … mia-story-095.jpg + 21 de video.
  „order” = indexurile poveștilor, în ordinea în care apar.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign de = false
  if localization.market.handle == 'deutschland'
    assign de = true
  endif
  assign pl = false
  if localization.market.handle == 'polska'
    assign pl = true
  endif
  assign ie = false
  if localization.market.handle == 'ireland'
    assign ie = true
  endif
  assign es = false
  if localization.market.handle == 'spania'
    assign es = true
  endif
  assign order = s.order | strip_newlines | remove: ' ' | split: ','
  assign total = order.size
  assign files = 'https://cdn.shopify.com/s/files/1/0954/5079/2260/files/'
-%}
{% render 'mia-de-head' %}
<style>
#mst-{{ section.id }}{--ink:#f4ece2;--mut:rgba(244,236,226,.62);--gold:#c9a36a;--bg:#17100c;--g:calc(max(0px,(100vw - 1440px) / 2) + 48px);background:radial-gradient(120% 90% at 85% 0%,#3a2418 0%,rgba(58,36,24,0) 55%),radial-gradient(90% 80% at 0% 100%,#2a1810 0%,rgba(42,24,16,0) 60%),var(--bg);color:var(--ink);padding:88px 0 76px;position:relative;overflow:hidden;font-family:Jost,system-ui,sans-serif}
#mst-{{ section.id }} .mst-in{max-width:1440px;margin:0 auto;padding:0 48px}
#mst-{{ section.id }} .mst-hd{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:36px}
#mst-{{ section.id }} .mst-k{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:10px;margin:0 0 16px}
#mst-{{ section.id }} .mst-k svg{width:15px;height:15px}
#mst-{{ section.id }} h2{font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(38px,4.4vw,64px);line-height:1.02;margin:0;color:var(--ink);letter-spacing:-.01em}
#mst-{{ section.id }} h2 em{font-style:italic;color:var(--gold)}
#mst-{{ section.id }} .mst-p{max-width:520px;color:var(--mut);font-size:15px;line-height:1.65;margin:16px 0 0;font-weight:300}
#mst-{{ section.id }} .mst-nav{display:flex;gap:10px;flex-shrink:0}
#mst-{{ section.id }} .mst-nav button{width:52px;height:52px;border-radius:50%;border:1px solid rgba(244,236,226,.25);background:transparent;color:var(--ink);cursor:pointer;display:grid;place-items:center;transition:background .25s,border-color .25s,transform .25s}
#mst-{{ section.id }} .mst-nav button:hover{background:var(--ink);color:#17100c;border-color:var(--ink)}
#mst-{{ section.id }} .mst-nav svg{width:18px;height:18px}
#mst-{{ section.id }} .mst-row{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:6px var(--g) 10px;margin:0 calc(var(--g) * -1);scroll-padding-left:var(--g)}
#mst-{{ section.id }} .mst-row::-webkit-scrollbar{display:none}
#mst-{{ section.id }} .mst-c{flex:0 0 auto;width:clamp(150px,14.2vw,212px);aspect-ratio:9/16;border-radius:20px;position:relative;cursor:pointer;scroll-snap-align:start;padding:2px;background:linear-gradient(145deg,#e6c58f,#8a5a34 45%,#d9a86a 75%,#f0d7a8);border:0;display:block;transition:transform .5s cubic-bezier(.2,.8,.2,1),box-shadow .5s;box-shadow:0 18px 40px -22px rgba(0,0,0,.8);opacity:0;transform:translateY(26px)}
#mst-{{ section.id }}.on .mst-c{opacity:1;transform:none;transition:opacity .8s ease var(--d),transform .9s cubic-bezier(.2,.8,.2,1) var(--d),box-shadow .5s}
#mst-{{ section.id }} .mst-c.seen{background:rgba(244,236,226,.18)}
#mst-{{ section.id }} .mst-c .fr{position:absolute;inset:2px;border-radius:18px;overflow:hidden;background:#2a1d15}
#mst-{{ section.id }} .mst-c img,#mst-{{ section.id }} .mst-c video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.2,.8,.2,1),opacity .4s}
#mst-{{ section.id }} .mst-c video{opacity:0}
#mst-{{ section.id }} .mst-c.pv video{opacity:1}
#mst-{{ section.id }} .mst-c:hover{transform:translateY(-6px)!important;box-shadow:0 30px 60px -24px rgba(0,0,0,.9)}
#mst-{{ section.id }} .mst-c:hover img{transform:scale(1.06)}
#mst-{{ section.id }} .mst-c .sh{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.35) 0%,rgba(0,0,0,0) 26%,rgba(0,0,0,0) 62%,rgba(0,0,0,.55) 100%);pointer-events:none}
#mst-{{ section.id }} .mst-c .vd{position:absolute;right:10px;bottom:10px;display:flex;align-items:center;gap:5px;font-size:11px;color:#fff;background:rgba(0,0,0,.35);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);padding:4px 8px 4px 6px;border-radius:20px}
#mst-{{ section.id }} .mst-c .vd svg{width:10px;height:10px}
#mst-{{ section.id }} .mst-c.first{width:clamp(150px,14.2vw,212px);background:none;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;box-shadow:none;border:1px solid rgba(244,236,226,.14);border-radius:20px}
#mst-{{ section.id }} .mst-c,#mst-{{ section.id }} .mst-c *{color:var(--ink)!important}
#mst-{{ section.id }} .mst-c.first .t2{color:var(--gold)!important}
#mst-{{ section.id }} .mst-c.first:hover{border-color:rgba(244,236,226,.35)}
#mst-{{ section.id }} .ring{width:108px;height:108px;border-radius:50%;padding:3px;position:relative;display:grid;place-items:center}
#mst-{{ section.id }} .ring:before{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 0deg,#f0d7a8,#c9a36a,#8a5a34,#e6c58f,#b0703f,#f0d7a8);animation:mstSpin 6s linear infinite}
#mst-{{ section.id }} .ring:after{content:"";position:absolute;inset:-10px;border-radius:50%;border:1px solid rgba(201,163,106,.35);animation:mstPulse 2.4s ease-out infinite}
#mst-{{ section.id }} .ring b{position:relative;width:100%;height:100%;border-radius:50%;background:#17100c;border:3px solid #17100c;overflow:hidden;display:block}
#mst-{{ section.id }} .ring b img{width:100%;height:100%;object-fit:cover;display:block}
#mst-{{ section.id }} .first .t1{font-family:'Cormorant Garamond',serif;font-size:24px;line-height:1.1;text-align:center;padding:0 12px}
#mst-{{ section.id }} .first .t2{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:8px}
#mst-{{ section.id }} .first .t2 i{width:6px;height:6px;border-radius:50%;background:#e0584a;box-shadow:0 0 0 0 rgba(224,88,74,.7);animation:mstLive 1.6s infinite}
#mst-{{ section.id }} .mst-ft{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:30px;color:var(--mut);font-size:13px}
#mst-{{ section.id }} .mst-ft a{color:var(--ink)!important;text-decoration:none!important;border-bottom:1px solid rgba(244,236,226,.35);padding-bottom:2px;display:inline-flex;align-items:center;gap:8px}
#mst-{{ section.id }} .mst-ft a:hover{border-color:var(--gold);color:var(--gold)!important}
#mst-{{ section.id }} .mst-bar{flex:1;max-width:280px;height:2px;background:rgba(244,236,226,.14);border-radius:2px;overflow:hidden}
#mst-{{ section.id }} .mst-bar i{display:block;height:100%;width:20%;background:var(--gold);border-radius:2px;transition:transform .2s linear}
@keyframes mstSpin{to{transform:rotate(360deg)}}
@keyframes mstPulse{0%{transform:scale(.92);opacity:.9}100%{transform:scale(1.18);opacity:0}}
@keyframes mstLive{0%{box-shadow:0 0 0 0 rgba(224,88,74,.7)}70%{box-shadow:0 0 0 8px rgba(224,88,74,0)}100%{box-shadow:0 0 0 0 rgba(224,88,74,0)}}
@media(max-width:900px){#mst-{{ section.id }}{padding:64px 0 56px;--g:20px}#mst-{{ section.id }} .mst-in{padding:0 20px}#mst-{{ section.id }} .mst-row{gap:12px}#mst-{{ section.id }} .mst-nav{display:none}#mst-{{ section.id }} .mst-c,#mst-{{ section.id }} .mst-c.first{width:42vw;max-width:190px}#mst-{{ section.id }} .mst-hd{margin-bottom:26px}#mst-{{ section.id }} .ring{width:92px;height:92px}#mst-{{ section.id }} .first .t1{font-size:21px}#mst-{{ section.id }} .mst-ft{flex-direction:column;align-items:flex-start}#mst-{{ section.id }} .mst-bar{width:100%;max-width:none}}

/* ——— Viewer ——— */
.mstv{position:fixed;inset:0;z-index:2147483000;display:none;font-family:Jost,system-ui,sans-serif;color:#fff;-webkit-tap-highlight-color:transparent}
.mstv.open{display:block}
.mstv .bd{position:absolute;inset:0;background:#0c0806;opacity:0;transition:opacity .45s ease}
.mstv.vis .bd{opacity:1}
.mstv .blur{position:absolute;inset:-60px;background-size:cover;background-position:center;filter:blur(60px) saturate(1.3) brightness(.55);opacity:0;transition:opacity .6s ease,background-image .6s}
.mstv.vis .blur{opacity:1}
.mstv .st{position:absolute;left:50%;top:50%;height:min(94vh,calc(94vw * 16 / 9));aspect-ratio:9/16;transform:translate(-50%,-50%);border-radius:18px;overflow:hidden;background:#000;box-shadow:0 40px 120px -20px rgba(0,0,0,.85);transition:transform .55s cubic-bezier(.2,.9,.2,1),opacity .4s ease,border-radius .4s}
.mstv .st.enter{opacity:0}
.mstv .md{position:absolute;inset:0}
.mstv .md img,.mstv .md video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000}
.mstv .md .ld{position:absolute;left:50%;top:50%;width:34px;height:34px;margin:-17px 0 0 -17px;border-radius:50%;border:2px solid rgba(255,255,255,.2);border-top-color:#fff;animation:mstSpin .8s linear infinite;opacity:0;transition:opacity .2s}
.mstv.loading .md .ld{opacity:1}
.mstv .md img,.mstv .md video{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;pointer-events:none}
.mstv .md .fade{animation:mstIn .45s ease both}
@keyframes mstIn{from{opacity:0;transform:scale(1.03)}to{opacity:1;transform:none}}
.mstv .top{position:absolute;left:0;right:0;top:0;padding:12px 12px 40px;background:linear-gradient(180deg,rgba(0,0,0,.55),rgba(0,0,0,0));z-index:3;pointer-events:none}
.mstv .segs{display:flex;gap:4px}
.mstv .segs i{flex:1;height:2.5px;border-radius:3px;background:rgba(255,255,255,.35);overflow:hidden;position:relative}
.mstv .segs i b{position:absolute;inset:0;background:#fff;transform-origin:left;transform:scaleX(0)}
.mstv .segs i.done b{transform:scaleX(1)}
.mstv .hd{display:flex;align-items:center;gap:10px;margin-top:12px;pointer-events:auto}
.mstv .hd .av{width:34px;height:34px;border-radius:50%;padding:2px;background:conic-gradient(#f0d7a8,#c9a36a,#8a5a34,#f0d7a8);flex-shrink:0}
.mstv .hd .av span{display:grid;place-items:center;width:100%;height:100%;border-radius:50%;background:#17100c;border:2px solid #17100c;font-family:'Cormorant Garamond',serif;font-size:17px;color:#f0d7a8}
.mstv .hd .nm{font-size:13px;font-weight:500;line-height:1.2}
.mstv .hd .nm small{display:block;font-weight:300;opacity:.75;font-size:11.5px}
.mstv .hd .sp{flex:1}
.mstv .hd button{width:36px;height:36px;border:0;background:transparent;color:#fff;cursor:pointer;display:grid;place-items:center;border-radius:50%;padding:0}
.mstv .hd button:hover{background:rgba(255,255,255,.12)}
.mstv .hd svg{width:20px;height:20px}
.mstv .hd .mu,.mstv .hd .pa{display:none}
.mstv.isv .hd .mu{display:grid}
.mstv .hd .pa{display:grid}
.mstv .tap{position:absolute;inset:0;z-index:2;display:flex;touch-action:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
.mstv .tap div{flex:1}
.mstv .tap .l{flex:0 0 32%}
.mstv .bot{position:absolute;left:0;right:0;bottom:0;padding:60px 16px 18px;background:linear-gradient(0deg,rgba(0,0,0,.6),rgba(0,0,0,0));z-index:3;display:flex;justify-content:center;pointer-events:none}
.mstv .cta{pointer-events:auto;display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,.94);color:#17100c!important;text-decoration:none!important;font-size:13px;letter-spacing:.06em;padding:12px 20px;border-radius:40px;font-weight:500;box-shadow:0 10px 30px -10px rgba(0,0,0,.6);transition:transform .25s}
.mstv .cta:hover{transform:translateY(-2px)}
.mstv .cta svg{width:14px;height:14px}
.mstv .cnt{position:absolute;right:14px;bottom:22px;z-index:4;font-size:11px;opacity:.7;letter-spacing:.08em;pointer-events:none}
.mstv .ar{position:absolute;top:50%;z-index:5;width:52px;height:52px;margin-top:-26px;border-radius:50%;border:0;background:rgba(255,255,255,.14);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#fff;cursor:pointer;display:grid;place-items:center;transition:background .2s,transform .2s}
.mstv .ar:hover{background:rgba(255,255,255,.28);transform:scale(1.06)}
.mstv .ar svg{width:20px;height:20px}
.mstv .ar.p{right:calc(50% + min(94vh,calc(94vw * 16 / 9)) * 9 / 32 + 28px)}
.mstv .ar.n{left:calc(50% + min(94vh,calc(94vw * 16 / 9)) * 9 / 32 + 28px)}
.mstv .x{position:absolute;right:22px;top:22px;z-index:5;width:46px;height:46px;border:0;border-radius:50%;background:rgba(255,255,255,.12);color:#fff;cursor:pointer;display:grid;place-items:center}
.mstv .x:hover{background:rgba(255,255,255,.25)}
.mstv .x svg{width:20px;height:20px}
.mstv .hd .x2{display:none}
.mstv .snd{position:absolute;left:50%;top:50%;z-index:4;transform:translate(-50%,-50%) scale(.8);background:rgba(0,0,0,.55);border-radius:50%;width:76px;height:76px;display:grid;place-items:center;opacity:0;transition:opacity .25s,transform .25s;pointer-events:none}
.mstv .snd.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
.mstv .snd svg{width:30px;height:30px}
.mstv.paused .segs i.cur b{animation-play-state:paused}
@media(max-width:700px){.mstv .st{height:100%;width:100%;aspect-ratio:auto;border-radius:0;left:0;top:0;transform:none}.mstv .ar,.mstv .x{display:none}.mstv .hd .x2{display:grid}.mstv .top{padding-top:max(10px,env(safe-area-inset-top))}.mstv .bot{padding-bottom:max(18px,env(safe-area-inset-bottom))}.mstv .st{background:transparent;box-shadow:none}.mstv .md img,.mstv .md video{background:transparent}}
@media(prefers-reduced-motion:reduce){#mst-{{ section.id }} .ring:before,#mst-{{ section.id }} .ring:after{animation:none}}
</style>

<section class="mst" id="mst-{{ section.id }}" data-mst>
  <div class="mst-in">
    <div class="mst-hd">
      <div>
        <p class="mst-k"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>{{ s.kicker }}</p>
        <h2>{{ s.title }}</h2>
        {%- if s.text != blank -%}<p class="mst-p">{{ s.text }}</p>{%- endif -%}
      </div>
      <div class="mst-nav">
        <button type="button" data-prev aria-label="{% if de %}Zurück{% elsif ie %}Previous{% elsif es %}Anterior{% elsif pl %}Wstecz{% else %}Înapoi{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" data-next aria-label="{% if de %}Weiter{% elsif ie %}Next{% elsif es %}Siguiente{% elsif pl %}Dalej{% else %}Înainte{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
    </div>

    <div class="mst-row" data-row>
      <button type="button" class="mst-c first" data-i="0" style="--d:0ms" aria-label="{{ s.open_label | escape }}">
        <span class="ring"><b><img src="{{ files }}mia-story-{{ order[0] | prepend: '00' | slice: -3, 3 }}.jpg?width=300" alt="" loading="lazy" width="108" height="108"></b></span>
        <span class="t1">{{ s.open_label }}</span>
        <span class="t2"><i></i>{{ total }} {{ s.count_label }}</span>
      </button>
      {%- for k in order -%}
        {%- assign kk = k | prepend: '00' | slice: -3, 3 -%}
        {%- assign d = forloop.index0 | times: 70 -%}
        {%- if d > 700 -%}{%- assign d = 700 -%}{%- endif -%}
        <button type="button" class="mst-c" data-i="{{ forloop.index0 }}" data-k="{{ k }}" style="--d:{{ d }}ms" aria-label="{{ s.story_label | escape }} {{ forloop.index }}">
          <span class="fr">
            <img data-src="{{ files }}mia-story-{{ kk }}.jpg?width=420" alt="" width="212" height="377" loading="lazy">
            <span class="sh"></span>
          </span>
        </button>
      {%- endfor -%}
    </div>

    <div class="mst-ft">
      <span class="mst-bar"><i data-bar></i></span>
      {%- if s.ig_url != blank -%}<a href="{{ s.ig_url }}" target="_blank" rel="noopener">{{ s.ig_label }} <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 17L17 7M9 7h8v8"/></svg></a>{%- endif -%}
    </div>
  </div>

  <div class="mstv" data-viewer role="dialog" aria-modal="true" aria-label="{{ s.kicker | escape }}">
    <div class="bd"></div>
    <div class="blur" data-blur></div>
    <button type="button" class="ar p" data-vp aria-label="{% if ie %}Previous{% elsif es %}Anterior{% else %}Zurück{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"/></svg></button>
    <button type="button" class="ar n" data-vn aria-label="{% if ie %}Next{% elsif es %}Siguiente{% else %}Weiter{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg></button>
    <button type="button" class="x" data-close aria-label="{% if ie %}Close{% elsif es %}Cerrar{% else %}Schließen{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    <div class="st" data-stage>
      <div class="md" data-media><span class="ld"></span></div>
      <div class="tap"><div class="l" data-tl></div><div class="r" data-tr></div></div>
      <div class="top">
        <div class="segs" data-segs></div>
        <div class="hd">
          <span class="av"><span>M</span></span>
          <span class="nm">{{ s.handle }}<small>{{ s.viewer_sub }}</small></span>
          <span class="sp"></span>
          <button type="button" class="pa" data-pause aria-label="Pause"><svg data-ic-pa viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></button>
          <button type="button" class="mu" data-mute aria-label="{% if ie %}Sound on/off{% elsif es %}Activar/desactivar sonido{% else %}Ton an/aus{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" stroke="none"/><path data-w d="M16 9a4 4 0 010 6M18.5 6.5a8 8 0 010 11"/><path data-m d="M16 9l6 6M22 9l-6 6" style="display:none"/></svg></button>
          <button type="button" class="x2" data-close aria-label="{% if ie %}Close{% elsif es %}Cerrar{% else %}Schließen{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
      </div>
      <div class="snd" data-snd></div>
      <div class="bot"><a class="cta" href="{{ s.cta_url }}" data-cta>{{ s.cta_label }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      <span class="cnt" data-cnt></span>
    </div>
  </div>
</section>

<script>
(function(){
  var root=document.getElementById('mst-{{ section.id }}');if(!root||root.__mst)return;root.__mst=1;
  var F='{{ files }}';
