            {%- elsif es -%}
              {%- assign ccs = '+34|ES,+351|PT,+33|FR,+49|DE,+43|AT,+41|CH,+39|IT,+31|NL,+32|BE,+44|UK,+353|IE,+48|PL,+420|CZ,+421|SK,+36|HU,+359|BG,+30|GR,+45|DK,+46|SE,+47|NO,+358|FI,+370|LT,+371|LV,+372|EE,+385|HR,+386|SI,+381|RS,+380|UA,+1|US,+40|RO,+373|MD' | split: ',' -%}
            {%- elsif pl -%}
              {%- assign ccs = '+48|PL,+49|DE,+43|AT,+41|CH,+39|IT,+34|ES,+33|FR,+31|NL,+32|BE,+44|UK,+353|IE,+420|CZ,+421|SK,+36|HU,+359|BG,+30|GR,+351|PT,+45|DK,+46|SE,+47|NO,+358|FI,+370|LT,+371|LV,+372|EE,+385|HR,+386|SI,+381|RS,+380|UA,+1|US,+40|RO,+373|MD' | split: ',' -%}
            {%- else -%}
