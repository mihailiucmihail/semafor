<div id="mia-notify-real" hidden>
{%- form 'customer', id: 'MiaNotifyForm' -%}
  <input type="hidden" name="contact[tags]" value="{{ tg }}">
  <input type="email" name="contact[email]" value="">
  <input type="hidden" name="contact[first_name]" value="">
  <input type="hidden" name="contact[last_name]" value="">
  <input type="hidden" name="contact[note]" value="">
  {%- if form.posted_successfully? -%}<span id="mnt-posted"></span>{%- endif -%}
{%- endform -%}
</div>
<script>
(function(){
  var box=document.getElementById('mia-notify');if(!box||box.__m)return;box.__m=1;
  var H=document.documentElement,KEY='mia_notify',BAR={{ t_bar | json }};
  function store(v){try{if(v)sessionStorage.setItem(KEY,JSON.stringify(v));else sessionStorage.removeItem(KEY);}catch(e){}}
  function read(){try{return JSON.parse(sessionStorage.getItem(KEY)||'null');}catch(e){return null;}}
  function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  /* place the panel where the sold-out button was */
  function place(){
    var el=[].slice.call(document.querySelectorAll('product-buy-buttons-element')).find(function(x){return !x.closest('.product-buy-buttons--drawer');});
    if(!el)return false;
    var blk=el.closest('.product-form--block')||el;
    blk.parentNode.insertBefore(box,blk.nextSibling);
    box.hidden=false;H.classList.add('mnt-on');return true;
  }
  /* channel switch */
  box.querySelectorAll('.sw button').forEach(function(b){b.addEventListener('click',function(){
    box.setAttribute('data-ch',b.dataset.c);
    box.querySelectorAll('.sw button').forEach(function(x){x.setAttribute('aria-selected',x===b?'true':'false');});
  });});
  /* both channels post the hidden Shopify customer form (with Shopify's captcha); the visible fields live inside the product form */
  var rf=document.getElementById('MiaNotifyForm');
  function F(n){return rf&&rf.querySelector('[name="contact['+n+']"]');}
  var baseTags=F('tags')?F('tags').value:'';
  /* Shopify's hCaptcha only arms a form after a focusin inside it – forward the focus of our visible fields */
  var armed=0;function arm(){if(armed||!F('email'))return;armed=Date.now();try{F('email').dispatchEvent(new FocusEvent('focusin',{bubbles:true}));}catch(x){var ev=document.createEvent('Event');ev.initEvent('focusin',true,true);F('email').dispatchEvent(ev);}}
  function bad(fld){fld.classList.remove('bad');void fld.offsetWidth;fld.classList.add('bad');fld.parentNode.querySelector('.err').classList.add('on');}
  function post(btn,data){
    btn.classList.add('busy');
    F('email').value=data.email;F('tags').value=baseTags+','+data.tag;
    F('first_name').value=data.fn||'';F('last_name').value=data.ln||'';F('note').value=data.note||'';
    store({h:box.dataset.h,e:data.show,c:data.c,t:Date.now()});
    arm();var wait=Math.max(0,1500-(Date.now()-armed));
    setTimeout(function(){if(rf.requestSubmit)rf.requestSubmit();else rf.submit();},wait);
    setTimeout(function(){btn.classList.remove('busy');},12000);
  }
  /* e-mail */
  var pe=box.querySelector('.pn-em'),inp=pe.querySelector('input'),fld=pe.querySelector('.fld'),go=pe.querySelector('.go');
  function sendE(){
    var v=(inp.value||'').trim();
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)){bad(fld);inp.focus();return;}
    if(!rf)return;
    post(go,{email:v,tag:'restock-email',show:v,c:'em'});
  }
  /* WhatsApp: number + country prefix; stored on the customer (name, note, tags) */
  var pw=box.querySelector('.pn-wa'),tin=pw.querySelector('input'),sel=pw.querySelector('select'),fw=pw.querySelector('.fld'),gw=pw.querySelector('.go');
  function sendW(){
    var d=(tin.value||'').replace(/[^\d+]/g,'');
    if(d.charAt(0)==='+'){var full=d;}else{d=d.replace(/^00/,'+');if(d.charAt(0)==='+'){full=d;}else{full=sel.value+d.replace(/^0+/,'');}}
    var digits=full.replace(/\D/g,'');
    if(digits.length<9||digits.length>15){bad(fw);tin.focus();return;}
    if(!rf)return;
    var e164='+'+digits;
    post(gw,{email:'wa'+digits+'@whatsapp.mihailiuc.ro',tag:'restock-whatsapp',fn:e164,ln:'WhatsApp',
      note:'WhatsApp '+e164+' | '+box.dataset.p+' | '+box.dataset.mk,show:e164,c:'wa'});
  }
  [[inp,sendE],[tin,sendW]].forEach(function(x){
    x[0].addEventListener('focus',arm);x[0].addEventListener('pointerdown',arm);
    x[0].addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();e.stopPropagation();x[1]();}});
    x[0].addEventListener('input',function(){var f=x[0].closest('.fld');f.classList.remove('bad');f.parentNode.querySelector('.err').classList.remove('on');});
  });
  sel.addEventListener('focus',arm);
  go.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();sendE();});
  gw.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();sendW();});
  /* "available colours" link → swatches */
  var cl=box.querySelector('[data-mnt-colors]');
  if(cl)cl.addEventListener('click',function(e){e.preventDefault();var s=document.querySelector('[id*="mia_swatches"]')||document.querySelector('.mia-sw, [class*="swatch"]');if(s)s.scrollIntoView({behavior:'smooth',block:'center'});});
  /* success after the Shopify customer form round-trip */
  function success(st){
    var t=box.querySelector('.okt'),tpl=st.c==='wa'?t.dataset.tw:t.dataset.t;
    t.innerHTML=st.e?esc(tpl).replace('[e]','<b>'+esc(st.e)+'</b>'):esc(t.dataset.t2);
    box.classList.add('done');
  }
  var st=read(),posted=!!document.getElementById('mnt-posted')||/[?&]customer_posted=true/.test(location.search);
  /* the welcome popup (-15%) also reacts to a posted customer form – keep it closed after a waitlist signup */
  var mine=!!(st&&st.h===box.dataset.h&&posted&&Date.now()-st.t<15*60*1000);
  if(mine){
    H.classList.add('mnt-posted');
    var kill=function(){var w=document.getElementById('MhlWelcomePopup');if(w){w.classList.remove('is-open','is-visible');}H.style.overflow='';};
    document.addEventListener('DOMContentLoaded',kill);window.addEventListener('load',kill);setTimeout(kill,0);setTimeout(kill,1200);
    success(st);setTimeout(function(){store(null);},3000);
    if(history.replaceState){var u=new URL(location.href);u.searchParams.delete('customer_posted');u.hash='';history.replaceState(null,'',u.toString());}
    setTimeout(function(){box.scrollIntoView({behavior:'smooth',block:'center'});},350);setTimeout(function(){box.scrollIntoView({behavior:'smooth',block:'center'});},1400);
  }
  /* mobile sticky bar: turn the dead "sold out" button into "notify me" */
  function bar(){
    document.querySelectorAll('.product-buy-buttons--drawer button.product-buy-buttons--primary').forEach(function(b){
      if(b.__mnt)return;b.__mnt=1;
      b.removeAttribute('disabled');b.classList.add('mnt-bar-go');
      var tx=b.querySelector('.product-buy-buttons--cta-text');if(tx)tx.textContent=BAR;else b.textContent=BAR;
      new MutationObserver(function(){if(b.hasAttribute('disabled'))b.removeAttribute('disabled');}).observe(b,{attributes:true,attributeFilter:['disabled']});
    });
  }
  window.addEventListener('click',function(e){
    var b=e.target&&e.target.closest&&e.target.closest('.product-buy-buttons--drawer button.product-buy-buttons--primary');if(!b||!b.__mnt)return;
    e.preventDefault();e.stopImmediatePropagation();
    box.scrollIntoView({behavior:'smooth',block:'center'});
    if(!box.classList.contains('done')){var fi=box.getAttribute('data-ch')==='wa'?tin:inp;setTimeout(function(){try{fi.focus({preventScroll:true});}catch(x){}},600);}
  },true);
  function run(){place();bar();}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run);else run();
  setTimeout(bar,1500);
})();
</script>
{%- endif -%}
