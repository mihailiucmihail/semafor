{%- liquid
  assign s = section.settings
  assign carrier = 'Hermes'
  if localization.country.iso_code == 'AT'
    assign carrier = 'der Österreichischen Post'
  endif
  assign p = s.product
  if p == blank
    assign p = all_products['mia-cafea-lunga-accesorii-aurii-piele-naturala']
  endif
  assign m = blank
  for md in p.media
    if md.media_type == 'image'
      assign a = md.alt | downcase
      if a contains 'umăr' or a contains 'umar'
        assign m = md
        break
      endif
    endif
  endfor
  if m == blank
    assign m = p.featured_media
  endif

  assign vid = blank
  assign vp = s.video_product
  if vp != blank
    assign vi = 0
    assign want = s.video_index | default: 1
    for md in vp.media
      if md.media_type == 'video'
        assign vi = vi | plus: 1
        if vi == want
          assign vid = md
          break
        endif
      endif
    endfor
  endif
  assign hd = ''
  assign sd = ''
  if vid != blank
    for src in vid.sources
      if src.format == 'mp4'
        if src.url contains '1080p'
          assign hd = src.url
        elsif src.url contains '720p'
          assign sd = src.url
        endif
      endif
    endfor
    if hd == ''
      assign hd = sd
    endif
    if sd == '' or sd == hd
      assign sd = hd | replace: 'HD-1080p-7.2Mbps', 'HD-720p-4.5Mbps'
    endif
  endif

  assign rc = shop.metafields.judgeme.all_reviews_count | default: '597'
  assign rr = shop.metafields.judgeme.all_reviews_rating | default: '4.9'
  assign rr = rr | times: 1.0 | round: 2
  assign mk = localization.market.handle
  if mk == 'ireland'
    assign rr = rr | append: ''
  else
    assign rr = rr | append: '' | replace: '.', ','
  endif
  comment
    v27: PL/DE – colour stat = MIA products published to this market (same number as hero/menu)
    IE: same as DE; decimal point instead of comma for the rating.
  endcomment
  assign n1 = s.n1
  assign l1 = s.l1
  if mk == 'polska' or mk == 'deutschland' or mk == 'ireland' or mk == 'spania'
    assign n1 = collections['mia'].products_count
    if mk == 'polska'
      capture kol
        render 'mia-pl-kolory', n: n1
      endcapture
      assign l1 = kol | strip | append: ' naszego bestsellera'
    endif
  endif
-%}
{% render 'mia-de-head' %}
<style>
body .mde .mde-atelier .i video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;background:#2a1a12}
body .mde .mde-atelier .i .vpos{object-position:50% 50%}
body .mde .mde-atelier .i .vplay{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:76px;height:76px;border-radius:50%;border:0;background:rgba(255,255,255,.9);box-shadow:0 10px 30px rgba(0,0,0,.25);cursor:pointer;opacity:0;pointer-events:none;transition:opacity .3s}
body .mde .mde-atelier .i .vplay:after{content:"";position:absolute;left:50%;top:50%;transform:translate(-35%,-50%);border-left:16px solid var(--ink);border-top:10px solid transparent;border-bottom:10px solid transparent}
body .mde .mde-atelier .i.vblk .vplay{opacity:1;pointer-events:auto}
body .mde .mde-atelier ul.q{list-style:none;margin:2px 0 0;padding:0;display:grid;gap:14px;max-width:30em}
body .mde .mde-atelier ul.q li{position:relative;padding-left:34px;font-size:16px;line-height:1.6;color:var(--ink)}
body .mde .mde-atelier ul.q li:before{content:"";position:absolute;left:0;top:.32em;width:20px;height:20px;border-radius:50%;border:1px solid var(--gold);background:radial-gradient(circle at 50% 50%,var(--gold) 0 3px,transparent 3.5px)}
body .mde .mde-atelier p.ps{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:22px;line-height:1.4;color:var(--ink);border-left:2px solid var(--gold);padding-left:18px}
@media(max-width:900px){body .mde .mde-atelier .i{aspect-ratio:3/4}}
@media(max-width:640px){
body .mde .mde-atelier .t{gap:18px}
body .mde .mde-atelier ul.q{gap:12px}
body .mde .mde-atelier ul.q li{font-size:15px;padding-left:30px}
body .mde .mde-atelier ul.q li:before{width:18px;height:18px}
body .mde .mde-atelier p.ps{font-size:20px}
}
</style>
<div class="mde">
<section class="mde-atelier" id="atelier">
  <div class="i">
    {%- if vid != blank and hd != '' -%}
      <video class="vpos" muted loop playsinline webkit-playsinline disablepictureinpicture preload="none" aria-label="{{ s.alt | escape }}" poster="{{ vid.preview_image | image_url: width: 1200 }}" data-hd="{{ hd }}" data-sd="{{ sd }}"></video>
      <button type="button" class="vplay" aria-label="{% if localization.market.handle == 'polska' %}Odtwórz wideo{% elsif localization.market.handle == 'ireland' %}Play video{% elsif localization.market.handle == 'spania' %}Reproducir vídeo{% else %}Video abspielen{% endif %}"></button>
      <script>
      (function(){
        var btn=document.currentScript.previousElementSibling,v=btn&&btn.previousElementSibling;if(!v||v.tagName!=='VIDEO')return;
        var box=v.parentNode;
        v.muted=true;v.defaultMuted=true;v.setAttribute('muted','');
        var src=(window.matchMedia('(max-width:900px)').matches?v.dataset.sd:v.dataset.hd);
        var loaded=false,visible=false,armed=false;
        function load(){if(loaded)return;loaded=true;v.preload='auto';v.src=src;try{v.load();}catch(e){}}
        function ok(){box.classList.remove('vblk');}
        function fail(e){if(e&&e.name==='AbortError')return;box.classList.add('vblk');arm();}
        function go(){load();v.muted=true;var p=v.play();if(p&&p.then){p.then(ok,fail);}}
        function arm(){if(armed)return;armed=true;var f=function(){if(visible||box.classList.contains('vblk')){go();}};['touchend','click','keydown'].forEach(function(t){document.addEventListener(t,f,{passive:true});});}
        v.addEventListener('playing',ok);
        btn.addEventListener('click',function(e){e.preventDefault();go();});
        if('IntersectionObserver' in window){
          new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)load();});},{rootMargin:'900px 0px'}).observe(v);
          new IntersectionObserver(function(es){es.forEach(function(e){
            visible=e.isIntersecting;
            if(visible){go();}else if(!v.paused){v.pause();}
          });},{threshold:0.2}).observe(v);
        }else{go();}
      })();
      </script>
    {%- elsif s.photo != blank -%}<img src="{{ s.photo }}{% if s.photo contains 'cdn.shopify.com/s/files' and s.photo contains '?' %}&width=1600{% endif %}" alt="{{ s.alt | escape }}" loading="lazy">
    {%- else -%}{{ m | image_url: width: 1600 | image_tag: loading: 'lazy', alt: s.alt, sizes: '(max-width: 900px) 100vw, 50vw', widths: '800, 1200, 1600' }}{%- endif -%}
  </div>
  <div class="t rv">
    <span class="n">IV · {{ s.kicker }}</span>
    <h2>{{ s.title }}</h2>
    {%- if s.text1 != blank -%}<p class="dc">{{ s.text1 }}</p>{%- endif -%}
    {%- if s.points != blank -%}
      {%- assign pts = s.points | newline_to_br | split: '<br />' -%}
      <ul class="q">{%- for pt in pts -%}{%- assign t = pt | strip -%}{%- if t != '' -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
    {%- endif -%}
    {%- if s.text2 != blank -%}<p class="ps">{{ s.text2 }}</p>{%- endif -%}
    <div class="sig">{{ s.sig }}<small>{{ s.sig_sub }}</small></div>
  </div>
</section>
<div class="mde-proof rv">
  <div><b>{{ n1 }}</b><span>{{ l1 }}</span></div>
  <div><b>{{ s.n2 }}</b><span>{{ s.l2 }}</span></div>
  <div><b>{{ s.n3 }}</b><span>{{ s.l3 | replace: 'Hermes', carrier }}</span></div>
  <div><b>{{ rr }}<i> ★</i></b><span>{{ rc }} {{ s.l4 }}</span></div>
</div>
</div>
{% schema %}
{
  "name": "MIA DE — Das Atelier",
  "settings": [
    { "type": "product", "id": "video_product", "label": "Video: produs (gol = fără video)" },
    { "type": "number", "id": "video_index", "label": "Video: al câtelea video din produs", "default": 1 },
    { "type": "product", "id": "product", "label": "Produs (foto, dacă nu e video)" },
    { "type": "text", "id": "photo", "label": "Sau foto URL (opțional)" },
    { "type": "text", "id": "alt", "label": "Alt", "default": "MIA, auf der Schulter getragen" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Das Atelier" },
    { "type": "text", "id": "title", "label": "Titlu (HTML)", "default": "Qualität in <em>jedem</em> Detail." },
    { "type": "textarea", "id": "text1", "label": "Paragraf 1" },
    { "type": "textarea", "id": "points", "label": "Puncte (câte unul pe rând)" },
    { "type": "textarea", "id": "text2", "label": "Paragraf final" },
    { "type": "text", "id": "sig", "label": "Semnătură", "default": "Mihail Mihailiuc" },
    { "type": "text", "id": "sig_sub", "label": "Sub semnătură", "default": "Gründer · MIHAILIUC" },
    { "type": "text", "id": "n1", "label": "Cifra 1", "default": "15" },
    { "type": "text", "id": "l1", "label": "Text 1", "default": "Trendfarben für unser Bestseller-Modell" },
    { "type": "text", "id": "n2", "label": "Cifra 2 (HTML)", "default": "26<i>×</i>23<i>×</i>11" },
    { "type": "text", "id": "l2", "label": "Text 2", "default": "cm – Breite, Höhe, Tiefe" },
    { "type": "text", "id": "n3", "label": "Cifra 3", "default": "5–6" },
    { "type": "text", "id": "l3", "label": "Text 3", "default": "Werktage – Versand mit Hermes" },
    { "type": "text", "id": "l4", "label": "Text 4 (după număr)", "default": "Bewertungen" }
  ],
  "presets": [{ "name": "MIA DE — Das Atelier" }]
}
{% endschema %}
