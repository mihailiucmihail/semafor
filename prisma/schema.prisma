// Refuz — data model. Matches the architecture doc: one block entry = one person with N identifiers.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id          String   @id @default(cuid())
  domain      String   @unique            // mihailiuc-2.myshopify.com
  accessToken String
  plan        String   @default("free")   // free | basic | pro (core/plans.ts)
  country     String   @default("RO")
  settings    Json     @default("{}")     // { thresholds:{block:100,warn:40}, yellowAction:"tag"|"prepaid"|"block", shareNetwork:bool, cancelRed:bool }
  installedAt DateTime @default(now())
  uninstalledAt DateTime?

  entries     BlockEntry[]
  checks      OrderCheck[]
  audits      AuditLog[]
  devices     DeviceEvent[]
  attempts    CheckoutAttempt[]
  templates   EmailTemplate[]
  sends       EmailSend[]
}

enum Reason {
  refuz_colet
  chargeback
  return_fraud
  abuse
  other
}
enum Source {
  manual
  order
  import
  courier
}
enum IdKind {
  email
  phone
  name
  address
  name_address
  device
}

model BlockEntry {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reason     Reason
  note       String?
  source     Source   @default(manual)
  orderId    String?                        // gid://shopify/Order/…
  orderName  String?                        // #1234 for display
  createdBy  String?                        // staff email / "system"
  shared     Boolean  @default(false)       // contributed to the network
  createdAt  DateTime @default(now())
  expiresAt  DateTime?

  identifiers Identifier[]
  @@index([shopId, createdAt])
}

model Identifier {
  id          String     @id @default(cuid())
  entryId     String
  entry       BlockEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  shopId      String                         // denormalised for the hot lookup
  kind        IdKind
  raw         String                         // as the customer typed it (shown to the merchant)
  normalized  String
  hash        String                         // HMAC hex
  normVersion Int        @default(1)

  @@index([shopId, kind, hash])
  @@index([hash])
}

enum Level {
  green
  yellow
  red
}

model OrderCheck {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId      String
  orderName    String?
  score        Int
  level        Level                          // own list
  networkShops Int      @default(0)
  networkLevel Level    @default(green)
  matched      Json                           // Match[]
  actionTaken  String?                        // tag | risk | prepaid | cancel | none
  checkedAt    DateTime @default(now())

  @@unique([shopId, orderId])
  @@index([shopId, checkedAt])
}

model AuditLog {
  id       String   @id @default(cuid())
  shopId   String
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actor    String
  action   String                              // entry.create | entry.delete | settings.update | gdpr.redact …
  entryId  String?
  payload  Json?
  at       DateTime @default(now())
  @@index([shopId, at])
}

model DeviceEvent {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceHash String
  orderId    String?
  seenAt     DateTime @default(now())
  @@index([shopId, deviceHash])
}

// ---- Network registry (logically separate; could move to its own DB later) ----
model NetworkReport {
  id        String   @id @default(cuid())
  hash      String                              // HMAC of normalized id
  kind      IdKind
  reason    Reason
  country   String
  shopRef   String                              // irreversible shop hash
  createdAt DateTime @default(now())
  expiresAt DateTime                            // createdAt + 24 months

  @@unique([hash, shopRef])
  @@index([hash])
  @@index([expiresAt])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Sessions of the public (App Store) Semafor app — kept apart from the original app's sessions
model PublicSession {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Every step a buyer submits in checkout (from the Semafor custom pixel), even when the checkout is then blocked.
// Lets Semafor link the identities one device tries ("tries the husband's e-mail/phone").
// Raw values stay in the merchant's own shop scope only; kept 120 days.
model CheckoutAttempt {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceId      String                          // random id kept in the browser
  fingerprint   String?                         // hash of UA + screen + language + timezone
  ip            String?
  checkoutToken String?
  event         String                          // contact | address | shipping | payment | completed
  email         String?
  phone         String?
  firstName     String?
  lastName      String?
  address1      String?
  city          String?
  orderId       String?
  // v2 (recovery e-mails): what the buyer had in the checkout and where
  host          String?                         // storefront host, e.g. mihailiuc.de
  locale        String?                         // checkout language, e.g. de
  country       String?                         // shipping / market country, e.g. DE
  currency      String?
  total         Float?
  items         Json?                           // [{ title, qty, image }]
  acceptsMarketing Boolean?                     // buyer ticked the e-mail marketing box in checkout
  discountCode  String?                         // discount already applied in the checkout (e.g. from a pop-up)
  discountPct   Float?                          // its size in % of the subtotal
  createdAt     DateTime @default(now())

  @@index([shopId, deviceId])
  @@index([shopId, checkoutToken])
  @@index([shopId, fingerprint])
  @@index([shopId, ip])
  @@index([shopId, createdAt])
}

// Recovery e-mails: templates the merchant writes / uploads (HTML with {{placeholders}}).
model EmailTemplate {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  locale    String                                // de | pl | ro | en …
  purpose   String   @default("manual")           // manual | auto1 (first reminder) | auto2 (second, with discount)
  subject   String
  html      String                                // used when design = "custom"
  design    String   @default("custom")           // elegant | minimal | modern | custom (own HTML)
  copy      Json?                                 // texts for a design: greeting, heading, text, button, note, discount
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, locale])
}

// Every recovery e-mail sent (manual from the client page or automatic).
model EmailSend {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceId      String
  checkoutToken String?
  email         String
  templateId    String?
  subject       String
  kind          String                          // manual | auto1 | auto2
  discountCode  String?
  discountPct   Int?
  status        String                          // sent | failed | skipped
  error         String?
  providerId    String?
  html          String?                         // the e-mail exactly as it was sent (shown in the client page)
  createdAt     DateTime @default(now())

  @@index([shopId, deviceId])
  @@index([shopId, email])
  @@index([shopId, createdAt])
}

/** Buyers who clicked "unsubscribe" in a Semafor e-mail: Semafor never writes to them again (per shop). */
model EmailOptOut {
  id        String   @id @default(cuid())
  shopId    String
  email     String                                 // lower-case
  createdAt DateTime @default(now())

  @@unique([shopId, email])
}
