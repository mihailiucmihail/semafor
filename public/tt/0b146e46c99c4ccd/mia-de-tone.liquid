{%- liquid
  assign de = false
  if localization.market.handle == 'deutschland'
    assign de = true
  endif
  assign pl = false
  if localization.market.handle == 'polska'
    assign pl = true
  endif
  assign s = section.settings
  assign n = 0
  for block in section.blocks
    assign p = block.settings.product
    if p != blank and p.featured_image != blank
      if p.available
        assign n = n | plus: 1
      endif
    endif
  endfor
  comment
    v27: PL/DE – one colour count everywhere (MIA products published to this market) + sold-out cards last
  endcomment
  assign passes = 2
  comment
    v49: sold-out colours are hidden on the homepage in every market
  endcomment
-%}
{% render 'mia-de-head' %}
<style>
.mfh{position:relative;z-index:0;isolation:isolate;background:#faf7f2;color:#2a1a12;font-family:'Jost',system-ui,sans-serif;width:100vw;margin-left:calc(50% - 50vw);overflow:hidden;-webkit-font-smoothing:antialiased;padding:0 0 26px}
.mfh *{box-sizing:border-box}
.mfh a{color:inherit;text-decoration:none}
.mfh .hd{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.mfh .hd .k{font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;color:#5a4a40;line-height:1.5}
.mfh .hd h1{margin:0;font-family:'Cormorant Garamond',Georgia,serif;font-size:28px;line-height:1.05;font-weight:500;letter-spacing:0;text-align:center}
.mfh .hd h1 em{font-style:italic;color:#8a4a2a}
.mfh .hd .c{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#8a4a2a;font-weight:500;text-align:right}
.mfh .fan{position:relative;height:min(52vh,410px);touch-action:pan-y;margin-top:22px;-webkit-user-select:none;user-select:none}
.mfh .card{--w:min(50vw,210px);position:absolute;left:50%;top:10px;width:var(--w);height:calc(var(--w) * 1.34);margin-left:calc(var(--w) / -2);border-radius:6px;overflow:hidden;background:#efe8dd;box-shadow:0 14px 34px rgba(42,26,18,.28);transform-origin:50% 170%;transform:rotate(0deg) scale(.92);transition:transform .85s cubic-bezier(.22,1,.36,1),box-shadow .4s,opacity .5s;will-change:transform;opacity:0;-webkit-tap-highlight-color:transparent}
.mfh.go .card{opacity:1}
.mfh .card img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}
.mfh .card .cl{position:absolute;left:0;right:0;bottom:0;background:rgba(250,247,242,.94);font-size:10px;letter-spacing:.18em;text-transform:uppercase;padding:9px 10px;text-align:center;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mfh .card .no{position:absolute;left:10px;top:10px;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:18px;color:#fff;text-shadow:0 1px 10px rgba(0,0,0,.5)}
.mfh .card.on{box-shadow:0 22px 48px rgba(42,26,18,.38)}
.mfh .nav{position:absolute;top:calc(10px + min(50vw,210px) * .67);transform:translateY(-50%);z-index:200;width:44px;height:44px;border-radius:50%;border:1px solid rgba(42,26,18,.18);background:rgba(250,247,242,.92);color:#2a1a12;font-size:18px;line-height:1;cursor:pointer;display:none;align-items:center;justify-content:center}
.mfh .nav.p{left:calc(50% - 430px)}.mfh .nav.n{right:calc(50% - 430px)}
.mfh .who{text-align:center;padding:0 20px;min-height:96px}
.mfh .who .nm{font-family:'Cormorant Garamond',serif;font-size:40px;line-height:1.05;font-weight:500;transition:opacity .3s}
.mfh .who .pr{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#5a4a40;margin-top:8px;font-weight:500;line-height:1.6}
.mfh .who .pr b{font-weight:500;color:#8a4a2a}
.mfh .who .pr s{opacity:.6;margin-right:6px}
.mfh .who a.go{display:inline-block;margin-top:14px;font-size:12px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;border-bottom:1px solid #c9a46b;padding-bottom:6px;color:#2a1a12!important}
.mfh .dots{display:flex;justify-content:center;gap:6px;margin-top:18px}
.mfh .dots i{width:6px;height:6px;border-radius:50%;background:rgba(42,26,18,.18);transition:background .3s,transform .3s}
.mfh .dots i.on{background:#8a4a2a;transform:scale(1.3)}
.mfh .foot{margin:22px 20px 0;padding-top:16px;border-top:1px solid rgba(42,26,18,.12);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#6f5f55;text-align:center;font-weight:500;line-height:2}
.mfh .foot b{color:#b8924f;font-weight:500}
@media(min-width:901px){
.mfh{padding-bottom:40px}
.mfh .hd .k{font-size:11px}
.mfh .hd h1{font-size:38px}
.mfh .fan{height:540px;margin-top:34px}
.mfh .card{--w:300px}
.mfh .card .cl{font-size:11px;padding:11px}
.mfh .card .no{font-size:22px}
.mfh .nav{display:flex;top:calc(10px + 300px * .67)}
.mfh .who .nm{font-size:54px}
.mfh .who .pr{font-size:13px}
.mfh .foot{max-width:900px;margin:30px auto 0;font-size:11px}
}
@media(max-width:900px) and (max-height:700px){.mfh .fan{height:44vh}}
@media(prefers-reduced-motion:reduce){.mfh .card{transition:none}}
</style>
<section class="mfh" id="ton" aria-roledescription="carousel">
  <div class="hd">
    <span class="k">{{ s.kicker }}</span>
    <h1>{% if de %}Wähle deine <em>Farbe</em>{% elsif pl %}Wybierz swój <em>kolor</em>{% else %}Alege-ți <em>nuanța</em>{% endif %}</h1>
    <span class="c">{{ n }} {% if de %}Farben{% elsif pl %}{% render 'mia-pl-kolory', n: n %}{% else %}nuanțe{% endif %}</span>
  </div>
  <div class="fan" data-fan>
    {%- assign i = 0 -%}
    {%- for pass in (1..passes) -%}
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p != blank and p.featured_image != blank -%}{%- if true -%}
      {%- if passes == 2 -%}{%- if pass == 1 and p.available == false -%}{%- continue -%}{%- endif -%}{%- if pass == 2 and p.available -%}{%- continue -%}{%- endif -%}{%- endif -%}
      <a class="card" href="{{ p.url }}" data-i="{{ i }}" data-name="{{ block.settings.name | escape }}" data-price="{{ p.price | money }}" data-cmp="{% if p.compare_at_price > p.price %}{{ p.compare_at_price | money }}{% endif %}" data-avail="{{ p.available }}" draggable="false" {{ block.shopify_attributes }}>
        {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'eager', alt: p.title, widths: '400, 600, 700', sizes: '(min-width: 901px) 300px, 50vw', draggable: 'false' }}
        <span class="no">{{ i | plus: 1 | prepend: '0' | slice: -2, 2 }}</span>
        <span class="cl">{% if p.available %}{{ block.settings.name }}{% else %}{% if de %}Ausverkauft{% elsif pl %}Wyprzedane{% else %}Stoc epuizat{% endif %}{% endif %}</span>
      </a>
      {%- assign i = i | plus: 1 -%}
      {%- endif -%}{%- endif -%}
    {%- endfor -%}
    {%- endfor -%}
    <button type="button" class="nav p" aria-label="{% if de %}Zurück{% elsif pl %}Wstecz{% else %}Înapoi{% endif %}" data-prev>←</button>
    <button type="button" class="nav n" aria-label="{% if de %}Weiter{% elsif pl %}Dalej{% else %}Înainte{% endif %}" data-next>→</button>
  </div>
  <div class="who" aria-live="polite">
    <div class="nm" data-fname></div>
    <div class="pr" data-fprice></div>
    <a class="go" href="/collections/mia" data-link>→</a>
    <div class="dots" data-dots></div>
  </div>
  <div class="foot">{% if de %}Echtes Leder · <b>Ab 100 € versandkostenfrei</b> · 14 Tage Rückgabe{% elsif pl %}Skóra naturalna · <b>Darmowa dostawa od 399 zł</b> · 14 dni na zwrot{% else %}Piele naturală · <b>Livrare gratuită peste 350 lei</b> · Retur 14 zile{% endif %}</div>
</section>
<script>
(function(){
  var sec=document.getElementById('ton');if(!sec||sec.__b)return;sec.__b=1;
  var T={% if de %}{av:'Auf Lager · Lieferung in 5–6 Werktagen',so:'Ausverkauft',first:'Bald wieder da',see:'Diese Farbe ansehen →',see2:'Details ansehen →',legal:'inkl. MwSt., zzgl. <a href="/pages/versand-lieferung" style="color:inherit;text-decoration:underline">Versandkosten</a>'}{% elsif pl %}{av:'Dostępna · Dostawa w 5–6 dni roboczych',so:'Wyprzedane',first:'Wkrótce wróci',see:'Zobacz ten kolor →',see2:'Zobacz szczegóły →'}{% else %}{av:'În stoc · livrare în 1–2 zile',so:'Stoc epuizat',first:'Revine în curând',see:'Vezi această nuanță →',see2:'Vezi detalii →'}{% endif %};
  var cards=[].slice.call(sec.querySelectorAll('.card')),fan=sec.querySelector('[data-fan]'),nameEl=sec.querySelector('[data-fname]'),priceEl=sec.querySelector('[data-fprice]'),linkEl=sec.querySelector('[data-link]'),dots=sec.querySelector('[data-dots]');
  var N=cards.length;if(!N)return;
  var fa=cards.findIndex(function(c){return c.getAttribute('data-avail')==='true'});
  var cur=fa>0?fa:0,stacked=true,step=12,timer=null,stopped=false,visible=true;
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var circ=N>=6;
  for(var k=0;k<N;k++){dots.appendChild(document.createElement('i'));}
  var dl=[].slice.call(dots.children);
  function dist(i){var d=i-cur;if(circ){d=((d%N)+N)%N;if(d>N/2)d-=N;}return d;}
  function layout(){
    cards.forEach(function(c,i){var d=dist(i);var dc=Math.max(-3,Math.min(3,d));var r=stacked?0:dc*step;
      c.style.opacity=(!stacked&&Math.abs(d)>3)?'0':'';
      var sc=stacked?.92:(d===0?1:.96);
      c.style.transform='rotate('+r+'deg) scale('+sc+')';
      c.style.zIndex=String(100-Math.abs(d));
      c.style.transitionDelay=stacked?'0ms':(Math.abs(d)*45)+'ms';
      c.classList.toggle('on',d===0);c.setAttribute('aria-hidden',d===0?'false':'true');c.tabIndex=d===0?0:-1;});
    dl.forEach(function(x,i){x.classList.toggle('on',i===cur)});
    var c=cards[cur];nameEl.textContent=c.getAttribute('data-name');
    var av=c.getAttribute('data-avail')==='true',cp=c.getAttribute('data-cmp');
    priceEl.innerHTML=av?((cp?'<s>'+cp+'</s>':'')+'<b>'+c.getAttribute('data-price')+'</b> · '+T.av+(T.legal?'<br><small style="font-size:.85em;letter-spacing:.04em;text-transform:none;opacity:.8">'+T.legal+'</small>':'')):('<b>'+T.so+'</b> · '+T.first);
    linkEl.href=c.getAttribute('href');linkEl.textContent=av?T.see:T.see2;
  }
  function go(n){cur=circ?((n%N)+N)%N:Math.max(0,Math.min(N-1,n));layout();}
  function stop(){stopped=true;if(timer){clearInterval(timer);timer=null;}}
  function start(){if(reduce||stopped||timer||!visible||stacked)return;timer=setInterval(function(){go(cur+1);},3200);}
  cards.forEach(function(c,i){c.addEventListener('click',function(e){if(i!==cur){e.preventDefault();stop();go(i);}});});
  sec.querySelector('[data-prev]').addEventListener('click',function(){stop();go(cur-1);});
  sec.querySelector('[data-next]').addEventListener('click',function(){stop();go(cur+1);});
  sec.addEventListener('keydown',function(e){if(e.key==='ArrowLeft'){stop();go(cur-1);}else if(e.key==='ArrowRight'){stop();go(cur+1);}});
  var sx=0,sy=0,moved=false,down=false;
  fan.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;sy=e.touches[0].clientY;moved=false;stop();},{passive:true});
  fan.addEventListener('touchmove',function(e){var dx=e.touches[0].clientX-sx,dy=e.touches[0].clientY-sy;if(!moved&&Math.abs(dx)>28&&Math.abs(dx)>Math.abs(dy)){moved=true;go(cur+(dx<0?1:-1));}},{passive:true});
  fan.addEventListener('mousedown',function(e){down=true;moved=false;sx=e.clientX;});
  window.addEventListener('mousemove',function(e){if(!down||moved)return;var dx=e.clientX-sx;if(Math.abs(dx)>40){moved=true;stop();go(cur+(dx<0?1:-1));}});
  window.addEventListener('mouseup',function(){down=false;});
  fan.addEventListener('click',function(e){if(moved){e.preventDefault();e.stopPropagation();moved=false;}},true);
  function spread(){if(!stacked)return;sec.classList.add('go');setTimeout(function(){stacked=false;layout();setTimeout(start,1400);},150);}
  layout();
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es){es.forEach(function(e){visible=e.isIntersecting;if(visible){spread();start();}else if(timer){clearInterval(timer);timer=null;}});},{threshold:.25}).observe(fan);
  }else{spread();}
  document.addEventListener('visibilitychange',function(){if(document.hidden&&timer){clearInterval(timer);timer=null;}else if(!document.hidden){start();}});
})();
</script>
{% schema %}
{
  "name": "MIA — Evantai nuanțe",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker (stânga sus)", "default": "Echtes Leder · Handgefertigt in Italien" },
    { "type": "text", "id": "byline", "label": "Sub MIA (nefolosit)", "default": "by MIHAILIUC" },
    { "type": "range", "id": "dur", "label": "Secunde per ton (nefolosit)", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "label", "label": "Etichetă (nefolosit)", "default": "Dein Ton" },
    { "type": "text", "id": "specs", "label": "Specificații (nefolosit)", "default": "-" },
    { "type": "text", "id": "cta", "label": "Buton coș (nefolosit)", "default": "In den Warenkorb" },
    { "type": "text", "id": "cta2", "label": "Buton produs (nefolosit)", "default": "Details" },
    { "type": "text", "id": "soldout", "label": "Text indisponibil (nefolosit)", "default": "-" },
    { "type": "text", "id": "ship", "label": "Livrare (nefolosit)", "default": "-" }
  ],
  "blocks": [
    { "type": "tone", "name": "Ton", "settings": [
      { "type": "product", "id": "product", "label": "Produs" },
      { "type": "text", "id": "name", "label": "Nume ton", "default": "Espresso" },
      { "type": "text", "id": "number", "label": "Număr", "default": "01" },
      { "type": "color", "id": "tone", "label": "Culoare", "default": "#4a2e22" },
      { "type": "text", "id": "tagline", "label": "Tagline", "default": "Tief, warm, klassisch." },
      { "type": "checkbox", "id": "force", "label": "Arată și dacă e epuizat", "default": false }
    ] }
  ],
  "presets": [{ "name": "MIA — Evantai nuanțe" }]
}
{% endschema %}
