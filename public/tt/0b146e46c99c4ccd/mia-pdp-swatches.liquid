{%- liquid
  assign de = false
  if localization.market.handle == 'deutschland'
    assign de = true
  endif
  assign pl = false
  if localization.market.handle == 'polska'
    assign pl = true
  endif
  assign list = 'mia-neagra-accesorii-aurii-piele-naturala|#1a1717|Neagră|Schwarz|neagra|Czarna,mia-cafea-lunga-accesorii-aurii-piele-naturala|#24140e|Espresso|Espresso|espresso|Espresso,mia-ciocolata-neagra-piele-naturala|#3d2419|Ciocolată neagră|Dunkle Schokolade|ciocolata|Ciemna Czekolada,mia-velur-ciocolata-neagra|#3a2620|Velur Ciocolată neagră|Velours Dunkle Schokolade|vciocolata|Zamsz Ciemna Czekolada,mia-dark-cherry|#5a1f2b|Dark Cherry|Dark Cherry|cherry|Dark Cherry,mia-burgundy-accesorii-aurii-piele-naturala|#6b1f26|Burgundy|Burgund|burgundy|Burgund,mia-velur-espresso|#5a3a2a|Velur Espresso|Velours Espresso|vespresso|Zamsz Espresso,mia-maro-accesorii-aurii-piele-naturala|#9a5a2a|Cognac|Cognac|cognac|Koniak,mia-taupe-accesorii-aurii-piele-naturala|#8c7b6b|Taupe|Taupe|taupe|Taupe,mia-velur-taupe|#9a8a7a|Velur Taupe|Velours Taupe|vtaupe|Zamsz Taupe,mia-greige|#a8998a|Greige|Greige|greige|Greige,mia-bej-accesorii-aurii-piele-naturala|#cbb79a|Velur Cashmere|Velours Kaschmir|vcashmere|Zamsz Kaszmir,mia-baby-blue|#a9c4d8|Baby Blue|Baby Blue|babyblue|Baby Blue,mia-bej-piele-naturala|#d6c3a5|Cashmere|Kaschmir|cashmere|Kaszmir,mia-ivory|#efe6d6|Ivory|Ivory|ivory|Ivory' | split: ','
  assign cur_handle = product.handle
  assign in_list = false
  assign cur_name = ''
  assign avail_n = 0
  for row in list
    assign f = row | split: '|'
    assign pp = all_products[f[0]]
    if pp != blank and pp.id == product.id
      assign in_list = true
      if de
        assign cur_name = f[3]
      elsif pl
        assign cur_name = f[5]
      else
        assign cur_name = f[2]
      endif
    endif
    if pp != blank and pp.available
      assign avail_n = avail_n | plus: 1
    endif
  endfor
-%}
{%- assign sty = section.settings.style | default: 'foto' -%}
{%- if in_list -%}
<style>
.msw{font-family:'Jost',system-ui,sans-serif;color:#2a1a12;text-align:center;margin:18px 0 24px;padding:0}
.msw .lb,.msw .ft{display:none!important}
.msw *{box-sizing:border-box}
.msw .row{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;max-width:460px;margin:0 auto}
.msw a{position:relative;display:block;width:60px;height:50px;border-radius:10px;background:transparent;border:1px solid transparent;padding:3px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .3s,background .3s,opacity .5s,filter .5s;opacity:0;transform:scale(.6) translateY(8px);-webkit-tap-highlight-color:transparent;text-decoration:none!important}
.msw a img{position:relative;z-index:1;display:block;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 1px 1px rgba(42,26,18,.28)) drop-shadow(0 3px 3px rgba(42,26,18,.14));pointer-events:none}
.msw a:after{content:"";position:absolute;left:50%;bottom:4px;width:70%;height:7px;transform:translateX(-50%);border-radius:50%;background:radial-gradient(ellipse at center,rgba(42,26,18,.32) 0,rgba(42,26,18,.12) 45%,transparent 72%);filter:blur(1px);pointer-events:none}
.msw a.so:after{opacity:.4}
.msw.in a{opacity:1;transform:none}
.msw a.cur{border-color:#2a1a12;background:#f4efe7}
.msw a.so{filter:none}
.msw.in a.so{opacity:.5}
.msw a.so:before{content:"";position:absolute;left:50%;top:6px;bottom:6px;width:1px;background:rgba(42,26,18,.45);transform:rotate(45deg);z-index:1}
.msw a.tap{animation:mswTap .5s cubic-bezier(.22,1,.36,1) both}
@keyframes mswTap{0%{transform:scale(1)}35%{transform:scale(.84)}100%{transform:scale(1.06)}}
@media(hover:hover){.msw a:hover{transform:translateY(-2px)!important;background:#f7f3ec}.msw a.so:hover{opacity:.7}}
.msw a:focus-visible{outline:1.5px solid #b8924f;outline-offset:2px}
.msw-on .main-product--mobile .carousel-nav-arrow{display:none!important}
.main-product--wrapper .product-buy-buttons--smart{display:none!important}
.main-product--wrapper form.product-form{transition:opacity .35s ease}
.msw-wait .main-product--wrapper form.product-form,.msw-wait .msw{opacity:0!important;pointer-events:none}
.msw.m{margin:12px 0 4px;position:relative;width:0;min-width:100%;max-width:100vw;contain:inline-size;overflow:hidden;flex:none;align-self:stretch}
.msw.m .row{flex-wrap:nowrap;justify-content:flex-start;max-width:none;overflow-x:auto;overflow-y:hidden;gap:6px;padding:6px 22px 8px;scroll-snap-type:x proximity;scrollbar-width:none;-webkit-overflow-scrolling:touch;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 22px,#000 calc(100% - 22px),transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 22px,#000 calc(100% - 22px),transparent 100%)}
.msw.m .row::-webkit-scrollbar{display:none}
.msw.m a{flex:none;scroll-snap-align:center}
@media(min-width:990px){.msw{text-align:left;margin:18px 0 26px}.msw .row{justify-content:flex-start;max-width:none}}
@media(prefers-reduced-motion:reduce){.msw a{transition:none}.msw a.tap{animation:none}}
/* ---- vitrina ---- */
.msw.v{margin:6px 0 16px}
.msw.v .row{gap:12px;max-width:none;padding:6px 4px 18px;background:none;border-radius:0;position:relative}
.msw.v .row:before,.msw.v .row:after{display:none}
.msw.v a{width:84px;height:112px;padding:0;border:0;border-radius:42px 42px 8px 8px;overflow:hidden;background:none;
 box-shadow:0 0 0 1px rgba(255,255,255,.9),0 1px 2px rgba(80,55,30,.18),0 6px 14px -6px rgba(80,55,30,.25)}
.msw.v a:before{content:"";position:absolute;inset:0;border-radius:inherit;width:auto;height:auto;top:0;bottom:0;left:0;right:0;transform:none;z-index:0;
 background:
  radial-gradient(ellipse 90% 60% at 50% 4%,rgba(255,241,220,.95),rgba(255,236,208,.55) 40%,rgba(255,232,200,0) 70%),
  linear-gradient(90deg,rgba(90,65,40,.20),rgba(90,65,40,.05) 14%,transparent 30%,transparent 70%,rgba(90,65,40,.05) 86%,rgba(90,65,40,.20)),
  linear-gradient(180deg,#f3ece2 0%,#ece3d6 45%,#e6dccd 78%,#e2d7c7 100%)}
.msw.v a .cv{position:absolute;left:0;right:0;top:0;height:46%;border-radius:42px 42px 0 0;z-index:0;background:radial-gradient(ellipse 100% 100% at 50% 0%,rgba(90,65,40,.28),rgba(90,65,40,.10) 45%,transparent 72%)}
.msw.v a .sh{position:absolute;left:0;right:0;bottom:0;height:27px;z-index:0;background:linear-gradient(180deg,rgba(90,65,40,.26) 0,rgba(90,65,40,.08) 3px,#ece3d7 4px,#f3ece2 55%,#f8f3ec 100%)}
.msw.v a .sh:before{content:"";position:absolute;left:0;right:0;top:4px;height:10px;background:linear-gradient(180deg,rgba(255,255,255,.55),transparent)}
.msw.v a .sh:after{content:"";position:absolute;left:0;right:0;bottom:0;height:5px;background:linear-gradient(180deg,#ddd2c2,#cbbda9);border-top:1px solid rgba(255,255,255,.9)}
.msw.v a:after{bottom:8px;width:62px;height:10px;background:radial-gradient(ellipse at center,rgba(60,40,18,.55) 0,rgba(60,40,18,.22) 40%,transparent 70%);filter:blur(1.5px);transition:all .5s}
.msw.v a .cs{position:absolute;left:50%;bottom:16px;width:56px;height:48px;transform:translateX(-50%);border-radius:40%;z-index:0;background:radial-gradient(ellipse at 50% 80%,rgba(70,45,20,.16),transparent 70%);filter:blur(4px)}
.msw.v a img{position:absolute;left:50%;bottom:10px;width:64px;height:auto;transform:translateX(-50%);filter:drop-shadow(0 1px 1px rgba(60,40,20,.35)) drop-shadow(0 3px 3px rgba(60,40,20,.18));transition:transform .55s cubic-bezier(.2,1.3,.4,1),filter .5s}
.msw.v a.cur{border:0;background:none;box-shadow:0 0 0 1px rgba(255,255,255,1),0 1px 2px rgba(80,55,30,.2),0 10px 22px -8px rgba(80,55,30,.35)}
.msw.v a.cur:before{background:radial-gradient(ellipse 95% 65% at 50% 4%,rgba(255,245,226,1),rgba(255,238,212,.65) 40%,rgba(255,232,200,0) 72%),linear-gradient(90deg,rgba(90,65,40,.16),rgba(90,65,40,.04) 14%,transparent 30%,transparent 70%,rgba(90,65,40,.04) 86%,rgba(90,65,40,.16)),linear-gradient(180deg,#f6f0e7 0%,#efe7db 45%,#e9dfd1 78%,#e4dac9 100%)}
.msw.v a.cur img{transform:translateX(-50%) translateY(-4px) scale(1.14);filter:drop-shadow(0 2px 2px rgba(60,40,20,.35)) drop-shadow(0 9px 8px rgba(60,40,20,.28))}
.msw.v a.cur:after{width:74px;height:13px;bottom:5px}
.msw.v a.so:before{transform:none;width:auto;height:auto;top:0;bottom:0;left:0;right:0;background:linear-gradient(180deg,#f3ece2 0%,#ece3d6 45%,#e6dccd 78%,#e2d7c7 100%)}
.msw.v.in a.so{opacity:1}
.msw.v a.so img{opacity:.5;filter:grayscale(.15) drop-shadow(0 1px 1px rgba(60,40,20,.25))}
.msw.v a.so .lab{position:absolute;left:0;right:0;bottom:1px;text-align:center;font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:#8a7662;z-index:2}
.msw.v a.tap{animation:none}
.msw.v a.tap img{animation:mswTapV .55s cubic-bezier(.2,1.3,.4,1) both}
@keyframes mswTapV{0%{transform:translateX(-50%) scale(1)}100%{transform:translateX(-50%) translateY(-4px) scale(1.14)}}
@media(hover:hover){.msw.v a:hover{transform:none!important;background:none}.msw.v a:hover img{transform:translateX(-50%) translateY(-2px) scale(1.05)}.msw.v a.so:hover{opacity:1}}
.msw.v.m .row{border-radius:0;padding:4px 22px 18px;gap:12px;-webkit-mask-image:none;mask-image:none}
.msw.v.m{margin:0 0 2px}
.msw.v .row{flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;scroll-snap-type:x proximity}
.msw.v .row::-webkit-scrollbar{display:none}
.msw.v a{flex:none;scroll-snap-align:center}
.msw.v .ft{display:block!important;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#9a8672;margin-top:10px}
/* ---- foto (photo cropped to niche) ---- */
.msw.f a .cv,.msw.f a .sh,.msw.f a .cs,.msw.f a:before{display:none}
.msw.f a>img:not(.ph){display:none}
.msw a .ph{display:none}
.msw:not(.v) .cv,.msw:not(.v) .sh,.msw:not(.v) .cs,.msw:not(.v) .lab{display:none}
.msw.f a .ph{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%;transform:scale(1.18);transform-origin:50% 50%;transition:transform .55s cubic-bezier(.2,1.3,.4,1),filter .5s;filter:none;opacity:1}
.msw.f a:after{display:none}
.msw.f a{box-shadow:0 1px 2px rgba(80,55,30,.16),0 8px 18px -8px rgba(80,55,30,.32);background:#e9e1d6}
.msw.f a.cur{box-shadow:0 0 0 1.5px #2a1a12,0 0 0 4px #fff,0 2px 3px rgba(80,55,30,.2),0 12px 24px -8px rgba(80,55,30,.4)}
.msw.f a.cur .ph{transform:scale(1.3)}
.msw.f a.so .ph{opacity:.55;filter:grayscale(.2)}
.msw.f a.so .lab{bottom:5px;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.6)}
.msw.f a.tap img{animation:none}
.msw.f a.tap .ph{animation:mswTapF .55s cubic-bezier(.2,1.3,.4,1) both}
@keyframes mswTapF{0%{transform:scale(1.18)}100%{transform:scale(1.3)}}
@media(hover:hover){.msw.f a:hover .ph{transform:scale(1.24)}}
</style>
<div class="msw{% if sty == 'vitrina' %} v{% elsif sty == 'foto' %} v f{% endif %}" id="msw" data-msw hidden>
  <div class="lb">{% if de %}Farbe{% elsif pl %}Kolor{% else %}Nuanța{% endif %} · <b data-lb>{{ cur_name }}</b></div>
  <div class="row" role="list">
    {%- for pass in (1..2) -%}
      {%- for row in list -%}
        {%- assign f = row | split: '|' -%}
        {%- assign pp = all_products[f[0]] -%}
        {%- if pp != blank -%}
          {%- assign show = false -%}
          {%- if pass == 1 -%}{%- if pp.available -%}{%- assign show = true -%}{%- endif -%}{%- else -%}{%- unless pp.available -%}{%- assign show = true -%}{%- endunless -%}{%- endif -%}
          {%- if show -%}
            {%- if de %}{% assign nm = f[3] %}{% elsif pl %}{% assign nm = f[5] %}{% else %}{% assign nm = f[2] %}{% endif -%}
            {%- assign fn = 'mia-swa-' | append: f[4] | append: '.png' -%}
            <a role="listitem" href="{{ pp.url }}" class="{% if pp.id == product.id %}cur{% endif %}{% unless pp.available %} so{% endunless %}" data-name="{{ nm | escape }}" title="{{ nm | escape }}" aria-label="{{ nm | escape }}{% unless pp.available %} – {% if de %}ausverkauft{% elsif pl %}wyprzedane{% else %}stoc epuizat{% endif %}{% endunless %}"{% if pp.id == product.id %} aria-current="true"{% endif %}><span class="cv"></span><span class="sh"></span><span class="cs"></span><img src="{{ fn | file_img_url: '160x' }}" alt="" width="54" height="41" loading="lazy">{% if pp.featured_image %}<img class="ph" src="{{ pp.featured_image | image_url: width: 360 }}" alt="" width="84" height="112" loading="lazy">{% endif %}{% unless pp.available %}<span class="lab">{% if de %}ausverkauft{% elsif pl %}wyprzedane{% else %}epuizat{% endif %}</span>{% endunless %}</a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
  <div class="ft">{% if sty == 'vitrina' or sty == 'foto' %}{% if de %}← Wischen für alle Farben →{% elsif pl %}← Przesuń, by zobaczyć kolory →{% else %}← glisați pentru toate nuanțele →{% endif %}{% else %}{% if de %}{{ avail_n }} Farben sofort lieferbar{% elsif pl %}Kolory dostępne od ręki: {{ avail_n }}{% else %}{{ avail_n }} nuanțe în stoc{% endif %}{% endif %}</div>
</div>
<script>
(function(){
  var w=document.getElementById('msw');if(!w||w.__b)return;w.__b=1;
  try{var q=new URLSearchParams(location.search).get('msw');if(q){w.classList.remove('v','f');if(q==='vitrina')w.classList.add('v');if(q==='foto')w.classList.add('v','f');}}catch(e){}
  var form=document.querySelector('.main-product--wrapper form.product-form')||document.querySelector('form.product-form');
  var mob=document.querySelector('.main-product--mobile');var nav=mob&&mob.querySelector('.carousel-nav-arrow');
  if(mob&&getComputedStyle(mob).display!=='none'){
    w.classList.add('m');document.documentElement.classList.add('msw-on');
    if(nav){nav.parentNode.insertBefore(w,nav.nextSibling);}else{mob.appendChild(w);}
  }else if(form){var pr=form.querySelector('[data-block-type="price"]');var top=form.querySelector('.product--breadcrumbs')||form.querySelector('[data-block-type="rating"]')||form.firstElementChild;if(pr){pr.parentNode.insertBefore(w,pr.nextSibling);}else{top.parentNode.insertBefore(w,top);}}
  w.hidden=false;
  var car=mob&&mob.querySelector('main-product-carousel,.carousel--root');
  if(car&&car.offsetHeight<150){var H=document.documentElement;H.classList.add('msw-wait');var fin=function(){H.classList.remove('msw-wait');};
    if('ResizeObserver' in window){var ro=new ResizeObserver(function(){if(car.offsetHeight>=150){fin();ro.disconnect();}});ro.observe(car);}
    window.addEventListener('load',function(){setTimeout(fin,300);});setTimeout(fin,3500);}
  if(w.classList.contains('m')||w.classList.contains('v')){var rw=w.querySelector('.row'),cu=w.querySelector('a.cur');if(cu){rw.scrollLeft=Math.max(0,cu.offsetLeft-(rw.clientWidth-cu.offsetWidth)/2);}}
  var lb=w.querySelector('[data-lb]'),curName=lb.textContent,links=[].slice.call(w.querySelectorAll('a'));
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  links.forEach(function(a,i){a.style.transitionDelay=reduce?'0ms':(i*35)+'ms';});
  function reveal(){w.classList.add('in');setTimeout(function(){links.forEach(function(a){a.style.transitionDelay='';});},links.length*35+600);}
  if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){if(es[0].isIntersecting){reveal();io.disconnect();}},{threshold:.2});io.observe(w);}else{reveal();}
  setTimeout(reveal,1800);
  var pre={};
  function prefetch(u){if(pre[u])return;pre[u]=1;var l=document.createElement('link');l.rel='prefetch';l.href=u;document.head.appendChild(l);}
  links.forEach(function(a){
    a.addEventListener('mouseenter',function(){lb.textContent=a.getAttribute('data-name');prefetch(a.href);});
    a.addEventListener('mouseleave',function(){lb.textContent=curName;});
    a.addEventListener('touchstart',function(){prefetch(a.href);},{passive:true});
    a.addEventListener('click',function(e){
      if(a.classList.contains('cur')){e.preventDefault();return;}
      if(e.metaKey||e.ctrlKey||e.shiftKey)return;
      e.preventDefault();
      lb.textContent=a.getAttribute('data-name');
      links.forEach(function(x){x.classList.remove('cur','tap');});
      void a.offsetWidth;a.classList.add('cur','tap');
      setTimeout(function(){location.href=a.href;},reduce?0:90);
    });
  });
  window.addEventListener('pageshow',function(e){if(e.persisted){links.forEach(function(x){x.classList.remove('tap');x.classList.toggle('cur',x.getAttribute('aria-current')==='true')});lb.textContent=curName;}});
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "MIA — Nuanțe pe produs",
  "settings": [
    { "type": "select", "id": "style", "label": "Stil nuanțe", "default": "foto", "options": [
      { "value": "simplu", "label": "Simplu (miniaturi cu umbră)" },
      { "value": "vitrina", "label": "Vitrină (nișe în perete)" },
      { "value": "foto", "label": "Vitrină foto (poza decupată în nișă)" }
    ] }
  ],
  "presets": [{ "name": "MIA — Nuanțe pe produs" }]
}
{% endschema %}
