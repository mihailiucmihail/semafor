{%- comment -%}
  MIA — rândul cu toate nuanțele. Ordine: produsul "first" (Espresso) mereu primul,
  apoi nuanțele disponibile de la închis la deschis, apoi cele epuizate (tot de la închis la deschis).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign col = s.collection
  if col == blank
    assign col = collections['mia']
  endif
  assign firstp = s.first
  if firstp == blank
    assign firstp = all_products['mia-cafea-lunga-accesorii-aurii-piele-naturala']
  endif
  assign order = s.order | strip_newlines | remove: ' ' | split: ','
  assign used = ',' | append: firstp.id | append: ','
  assign n = 0
  comment
    v27: PL/DE – the pinned first product is shown first only while it is available; when sold out it moves to the sold-out group (end)
  endcomment
  assign mk = localization.market.handle
  assign pin_first = true
  if true
    if firstp.available == false
      assign pin_first = false
      assign used = ','
    endif
  endif
-%}
{% render 'mia-de-head' %}
<style>
  .mde-rail .cd .pr .cmp{opacity:.55;font-weight:400;margin-right:4px}
  .mde-rail .cd .so{position:absolute;right:14px;top:14px;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#8a4a2a;background:rgba(255,255,255,.9);padding:5px 9px;font-weight:500}
  .mde-rail .cd.out .ph img{opacity:.72;filter:saturate(.85)}
  .mde-rail{padding-top:72px}
  .mde-rail .cd{flex:0 0 280px;width:280px;min-width:0;max-width:280px}
  .mde-rail .cd .b{flex-direction:column;align-items:flex-start;justify-content:flex-start;gap:6px;min-height:74px}
  .mde-rail .cd .nm{display:block;width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .mde-rail .cd .pr{white-space:nowrap}
  .mde-rail .ch{margin-bottom:28px;align-items:center}
  @media(max-width:900px){.mde-rail .cd{flex-basis:230px;width:230px;max-width:230px}}
  @media(max-width:640px){.mde-rail{padding-top:44px}.mde-rail .ch{margin-bottom:20px}.mde-rail .ch h2{font-size:34px}}
</style>
<div class="mde">
<section class="mde-rail" id="reihe">
  <div class="ch rv"><h2>{{ s.title }}</h2><a class="link r" href="{{ col.url }}">{{ s.all_label }}</a></div>
  <div class="cards rv">
    {%- if pin_first and firstp != blank and firstp.featured_image != blank -%}
      {%- assign n = n | plus: 1 -%}
      {%- render 'mia-rail-card', p: firstp, n: n, soldout: s.soldout -%}
    {%- endif -%}
    {%- for pass in (1..2) -%}
      {%- for h in order -%}
        {%- assign p = all_products[h] -%}
        {%- assign pk = ',' | append: p.id | append: ',' -%}
        {%- if used contains pk -%}{%- continue -%}{%- endif -%}
        {%- if p == blank or p.featured_image == blank -%}{%- continue -%}{%- endif -%}
        {%- if pass == 1 and p.available == false -%}{%- continue -%}{%- endif -%}
        {%- if pass == 2 and p.available -%}{%- continue -%}{%- endif -%}
        {%- assign used = used | append: p.id | append: ',' -%}
        {%- assign n = n | plus: 1 -%}
        {%- render 'mia-rail-card', p: p, n: n, soldout: s.soldout -%}
      {%- endfor -%}
      {%- for p in col.products -%}
        {%- assign pk = ',' | append: p.id | append: ',' -%}
        {%- if used contains pk or p.featured_image == blank -%}{%- continue -%}{%- endif -%}
        {%- if pass == 1 and p.available == false -%}{%- continue -%}{%- endif -%}
        {%- if pass == 2 and p.available -%}{%- continue -%}{%- endif -%}
        {%- assign used = used | append: p.id | append: ',' -%}
        {%- assign n = n | plus: 1 -%}
        {%- render 'mia-rail-card', p: p, n: n, soldout: s.soldout -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>
</div>
{% schema %}
{
  "name": "MIA DE — Reihe",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Colecție" },
    { "type": "product", "id": "first", "label": "Primul produs (mereu Nº 01)" },
    { "type": "text", "id": "title", "label": "Titlu (HTML)", "default": "Die MIA-Kollektion" },
    { "type": "textarea", "id": "order", "label": "Ordine (handle-uri, de la închis la deschis)", "default": "mia-ciocolata-neagra-piele-naturala,mia-velur-ciocolata-neagra,mia-neagra-accesorii-aurii-piele-naturala,mia-velur-espresso,mia-dark-cherry,mia-burgundy-accesorii-aurii-piele-naturala,mia-maro-accesorii-aurii-piele-naturala,mia-taupe-accesorii-aurii-piele-naturala,mia-velur-taupe,mia-greige,mia-baby-blue,mia-bej-accesorii-aurii-piele-naturala,mia-bej-piele-naturala,mia-ivory" },
    { "type": "range", "id": "limit", "label": "(nefolosit)", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "all_label", "label": "Link", "default": "Alle ansehen →" },
    { "type": "text", "id": "more_label", "label": "(nefolosit)", "default": "weitere Töne" },
    { "type": "text", "id": "soldout", "label": "Etichetă epuizat", "default": "Ausverkauft" }
  ],
  "presets": [{ "name": "MIA DE — Reihe" }]
}
{% endschema %}