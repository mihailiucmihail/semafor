{%- if localization.market.handle == 'deutschland' or localization.market.handle == 'ro' or localization.market.handle == 'polska' or localization.market.handle == 'ireland' or localization.market.handle == 'spania' -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400&display=swap" rel="stylesheet">
<style>
  .mia-logo-link{display:inline-flex;color:inherit;text-decoration:none}
  .mia-logo{display:inline-flex;flex-direction:column;align-items:stretch;line-height:1;color:currentColor;font-family:'Jost','Helvetica Neue',Arial,sans-serif}
  .mia-logo__m{display:block;font-weight:300;font-size:30px;letter-spacing:.08em;padding-left:.08em;white-space:nowrap;text-align:center}
  .mia-logo__m span{display:inline-block}
  .mia-logo__b{display:flex;justify-content:space-between;font-weight:400;font-size:9px;margin-top:4px}
  @media (max-width:768px){.mia-logo__m{font-size:24px}.mia-logo__b{font-size:7.5px;margin-top:3px}}
  html.mia-intro .mia-logo__m{animation:miaBreath 1.3s cubic-bezier(.2,.7,.2,1) .1s both}
  html.mia-intro .mia-logo__m span{animation:miaIn 1.1s cubic-bezier(.2,.7,.2,1) both}
  html.mia-intro .mia-logo__m span:nth-child(1){animation-delay:.1s}
  html.mia-intro .mia-logo__m span:nth-child(2){animation-delay:.2s}
  html.mia-intro .mia-logo__m span:nth-child(3){animation-delay:.3s}
  html.mia-intro .mia-logo__b{animation:miaFade .7s ease 1s both}
  @keyframes miaBreath{from{letter-spacing:.33em;padding-left:.33em}to{letter-spacing:.08em;padding-left:.08em}}
  @keyframes miaIn{from{opacity:0;filter:blur(4px)}to{opacity:1;filter:blur(0)}}
  @keyframes miaFade{from{opacity:0}to{opacity:1}}
  @media (prefers-reduced-motion:reduce){html.mia-intro .mia-logo__m,html.mia-intro .mia-logo__m span,html.mia-intro .mia-logo__b{animation:none}}
  .header--secondary-nav .header--account{display:none !important}
</style>
<script>
  (function(){try{if(!sessionStorage.getItem('mia-logo-seen')){document.documentElement.classList.add('mia-intro');sessionStorage.setItem('mia-logo-seen','1')}}catch(e){}})();
</script>
{%- endif -%}
<a
  href="{{ routes.root_url }}"
  title="{{ shop.name }}"
  itemscope
  itemprop="url"
  itemtype="https://schema.org/Organization"
  {% if localization.market.handle == 'deutschland' or localization.market.handle == 'ro' or localization.market.handle == 'polska' or localization.market.handle == 'ireland' or localization.market.handle == 'spania' %}class="mia-logo-link"{% endif %}
>
  {%- if localization.market.handle == 'deutschland' or localization.market.handle == 'ro' or localization.market.handle == 'polska' or localization.market.handle == 'ireland' or localization.market.handle == 'spania' -%}
    {%- comment -%} MIA by MIHAILIUC — logo tipografic cu animatia Respiratie, pentru pietele Germania si Romania {%- endcomment -%}
    <span class="mia-logo" itemprop="name" aria-label="MIA by MIHAILIUC">
      <span class="mia-logo__m" aria-hidden="true"><span>M</span><span>I</span><span>A</span></span>
      <span class="mia-logo__b" aria-hidden="true"><span>B</span><span>Y</span><span>&nbsp;</span><span>M</span><span>I</span><span>H</span><span>A</span><span>I</span><span>L</span><span>I</span><span>U</span><span>C</span></span>
    </span>
  {%- elsif logo -%}
    {%- liquid
      assign width = height | times: logo.aspect_ratio | round
      assign twice_width = width | times: 2
      assign mobile_width = mobile_height | times: logo.aspect_ratio | round

      capture logo_vars
        echo '--width:' | append: width | append: 'px;'
        echo '--mobile-width:' | append: mobile_width | append: 'px;'
      endcapture
    -%}

    {{-
      logo |
      image_url: width: twice_width |
      image_tag: itemprop: "logo", style: logo_vars, fetchpriority: 'high', loading: 'eager'
    -}}

  {%- else -%}
    <div data-item="section-heading">
      {{- shop.name -}}
    </div>

  {%- endif -%}
</a>
