{%- comment -%} MIA by MIHAILIUC — mobile menu "Die Farbkarte" (market deutschland) {%- endcomment -%}
{%- liquid
  assign de = false
  if localization.market.handle == 'deutschland'
    assign de = true
  endif
  assign ie = false
  if localization.market.handle == 'ireland'
    assign ie = true
  endif
  assign es = false
  if localization.market.handle == 'spania'
    assign es = true
  endif
  assign pl = false
  if localization.market.handle == 'polska'
    assign pl = true
  endif
  assign mh = 'main-menu-ro'
  if de
    assign mh = 'main-menu-de'
  endif
  if ie
    assign mh = 'main-menu-ie'
  endif
  if es
    assign mh = 'main-menu-es'
  endif
  if pl
    assign mh = 'main-menu-pl'
  endif
  assign col = collections['mia']
  assign firstp = all_products['mia-cafea-lunga-accesorii-aurii-piele-naturala']
  assign jm = shop.metafields.judgeme
  assign rcount = jm.all_reviews_count
  assign rrating = jm.all_reviews_rating | round: 2
  unless ie
    assign rrating = rrating | replace: '.', ','
  endunless
  assign n = 0
  for p in col.products
    if p.available and p.featured_image != blank
      assign n = n | plus: 1
    endif
  endfor
  comment
    v27: PL/DE – one colour count everywhere (MIA products published to this market); sold-out pinned card goes last
  endcomment
  assign first_last = false
  if de or pl or ie or es
    assign n = col.products_count
    if firstp.available == false
      assign first_last = true
    endif
  endif
-%}
<style>
.mdm{position:fixed;inset:0;z-index:100000;background:#faf7f2;color:#2a1a12;font-family:'Jost',system-ui,sans-serif;display:flex;flex-direction:column;opacity:0;visibility:hidden;transform:translateY(-14px);transition:opacity .45s cubic-bezier(.22,1,.36,1),transform .55s cubic-bezier(.22,1,.36,1),visibility 0s .5s;overflow:hidden;-webkit-font-smoothing:antialiased}
.mdm.open{opacity:1;visibility:visible;transform:none;transition:opacity .45s cubic-bezier(.22,1,.36,1),transform .55s cubic-bezier(.22,1,.36,1),visibility 0s}
.mdm *{box-sizing:border-box}
.mdm a{color:inherit;text-decoration:none}
.mdm .top{height:64px;flex:none;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 20px;border-bottom:1px solid rgba(42,26,18,.1)}
.mdm .top button{background:none;border:0;padding:0;font:inherit;color:inherit;font-size:11px;letter-spacing:.24em;text-transform:uppercase;font-weight:500;text-align:left;cursor:pointer}
.mdm .top .seal{font-family:'Cormorant Garamond',Georgia,serif;font-size:24px;font-weight:500;letter-spacing:.04em}
.mdm .top .cnt{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#8a4a2a;font-weight:500;text-align:right}
.mdm .fan{position:relative;flex:none;height:min(47vh,380px);touch-action:pan-y}
.mdm .card{position:absolute;left:50%;top:14px;width:min(48vw,200px);height:calc(min(48vw,200px)*1.34);margin-left:calc(min(48vw,200px)/-2);border-radius:6px;overflow:hidden;background:#efe8dd;box-shadow:0 14px 34px rgba(42,26,18,.28);transform-origin:50% 170%;transform:rotate(0deg) scale(.92);transition:transform .85s cubic-bezier(.22,1,.36,1),box-shadow .4s,opacity .5s;will-change:transform;opacity:0}
.mdm.open .card{opacity:1}
.mdm .card img{width:100%;height:100%;object-fit:cover;display:block}
.mdm .card .cl{position:absolute;left:0;right:0;bottom:0;background:rgba(250,247,242,.94);font-size:10px;letter-spacing:.18em;text-transform:uppercase;padding:8px 10px;text-align:center;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mdm .card .cl.so{color:#8a4a2a}
.mdm .card .no{position:absolute;left:10px;top:10px;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:18px;color:#fff;text-shadow:0 1px 10px rgba(0,0,0,.5)}
.mdm .card.on{box-shadow:0 22px 48px rgba(42,26,18,.38)}
.mdm .who{text-align:center;padding:2px 20px 0;flex:none;min-height:64px}
.mdm .who .nm{font-family:'Cormorant Garamond',serif;font-size:30px;line-height:1;font-weight:500}
.mdm .who .pr{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#5a4a40;margin-top:6px;font-weight:500}
.mdm .who .pr b{font-weight:500;color:#8a4a2a}
.mdm .who a{display:inline-block;margin-top:8px;font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;border-bottom:1px solid #c9a46b;padding-bottom:4px}
.mdm .list{flex:1;overflow-y:auto;padding:18px 20px 12px;display:flex;flex-direction:column}
.mdm .list a{font-family:'Cormorant Garamond',serif;font-size:24px;line-height:1;padding:13px 0;border-bottom:1px solid rgba(42,26,18,.12);display:flex;justify-content:space-between;align-items:center;gap:12px;opacity:0;transform:translateX(-12px);transition:opacity .6s cubic-bezier(.22,1,.36,1),transform .6s cubic-bezier(.22,1,.36,1)}
.mdm.open .list a{opacity:1;transform:none}
.mdm .list a small{font-family:'Jost',sans-serif;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#8a4a2a;font-weight:500;white-space:nowrap}
.mdm .foot{flex:none;padding:10px 20px 18px;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#6f5f55;text-align:center;font-weight:500}
.mdm .foot b{color:#b8924f;font-weight:500}
@media(min-width:901px){.mdm{display:none}}
@media(max-height:660px){.mdm .fan{height:40vh}.mdm .list a{font-size:21px;padding:10px 0}}
@media(prefers-reduced-motion:reduce){.mdm,.mdm .card,.mdm .list a{transition:none}}
body.mdm-lock{overflow:hidden}
</style>
<div class="mdm" id="mdm" aria-hidden="true" role="dialog" aria-label="{% if de %}Menü{% elsif ie %}Menu{% elsif es %}Menú{% elsif pl %}Menu{% else %}Meniu{% endif %}">
  <div class="top">
    <button type="button" data-mdm-close>{% if de %}Schließen{% elsif ie %}Close{% elsif es %}Cerrar{% elsif pl %}Zamknij{% else %}Închide{% endif %} ✕</button>
    <span class="seal">MIA</span>
    <span class="cnt">{{ n }} {% if de %}Farben{% elsif ie %}colours{% elsif es %}colores{% elsif pl %}{% render 'mia-pl-kolory', n: n %}{% else %}nuanțe{% endif %}</span>
  </div>
  <div class="fan" data-mdm-fan>
    {%- assign i = 0 -%}
    {%- if first_last == false and firstp != blank and firstp.featured_image != blank -%}
      {%- assign nm = firstp.title | remove_first: 'MIA ' | downcase | split: ' ' -%}
      {%- capture nmc %}{% for w in nm %}{{ w | capitalize }} {% endfor %}{% endcapture -%}
      <a class="card" href="{{ firstp.url }}" data-i="{{ i }}" data-name="{{ nmc | strip | escape }}" data-price="{{ firstp.price | money }}" data-cmp="{% if firstp.compare_at_price > firstp.price %}{{ firstp.compare_at_price | money }}{% endif %}" data-avail="{{ firstp.available }}" data-url="{{ firstp.url }}">
        {{ firstp.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: firstp.title, widths: '400, 600' }}
        <span class="no">01</span>
        <span class="cl{% unless firstp.available %} so{% endunless %}">{% if firstp.available %}{{ nmc | strip }}{% else %}{% if de %}Ausverkauft{% elsif ie %}Sold out{% elsif es %}Agotado{% elsif pl %}Wyprzedane{% else %}Stoc epuizat{% endif %}{% endif %}</span>
      </a>
      {%- assign i = i | plus: 1 -%}
    {%- endif -%}
    {%- for p in col.products -%}
      {%- if p.available and p.featured_image != blank and p.handle != firstp.handle and i < 8 -%}
        {%- assign nm = p.title | remove_first: 'MIA ' | downcase | split: ' ' -%}
        {%- capture nmc %}{% for w in nm %}{{ w | capitalize }} {% endfor %}{% endcapture -%}
        <a class="card" href="{{ p.url }}" data-i="{{ i }}" data-name="{{ nmc | strip | escape }}" data-price="{{ p.price | money }}" data-cmp="{% if p.compare_at_price > p.price %}{{ p.compare_at_price | money }}{% endif %}" data-avail="true" data-url="{{ p.url }}">
          {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title, widths: '400, 600' }}
          <span class="no">{{ i | plus: 1 | prepend: '0' | slice: -2, 2 }}</span>
          <span class="cl">{{ nmc | strip }}</span>
        </a>
        {%- assign i = i | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if first_last and firstp != blank and firstp.featured_image != blank -%}
      {%- assign nm = firstp.title | remove_first: 'MIA ' | downcase | split: ' ' -%}
      {%- capture nmc %}{% for w in nm %}{{ w | capitalize }} {% endfor %}{% endcapture -%}
      <a class="card" href="{{ firstp.url }}" data-i="{{ i }}" data-name="{{ nmc | strip | escape }}" data-price="{{ firstp.price | money }}" data-cmp="" data-avail="false" data-url="{{ firstp.url }}">
        {{ firstp.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: firstp.title, widths: '400, 600' }}
        <span class="no">{{ i | plus: 1 | prepend: '0' | slice: -2, 2 }}</span>
        <span class="cl so">{% if de %}Ausverkauft{% elsif ie %}Sold out{% elsif es %}Agotado{% else %}Wyprzedane{% endif %}</span>
      </a>
      {%- assign i = i | plus: 1 -%}
    {%- endif -%}
  </div>
  <div class="who">
    <div class="nm" data-mdm-name></div>
    <div class="pr" data-mdm-price></div>
    <a href="{{ col.url }}" data-mdm-link>{% if de %}Ansehen{% elsif ie %}View{% elsif es %}Ver{% elsif pl %}Zobacz{% else %}Vezi{% endif %} →</a>
  </div>
  <nav class="list">
    {%- for link in linklists[mh].links -%}
      {%- assign u = link.url -%}
      {%- if u contains '#farben' %}{% assign u = '/#ton' %}{% endif -%}
      <a href="{{ u }}" style="transition-delay:{{ forloop.index0 | times: 60 | plus: 250 }}ms">{{ link.title }}{% if link.url contains '/collections/mia' %}<small>{{ n }} {% if de %}Farben{% elsif ie %}colours{% elsif es %}colores{% elsif pl %}{% render 'mia-pl-kolory', n: n %}{% else %}nuanțe{% endif %}</small>{% endif %}</a>
    {%- endfor -%}
    <a href="https://judge.me/reviews/stores/mihailiuc.co" target="_blank" rel="noopener" style="transition-delay:{{ linklists[mh].links.size | times: 60 | plus: 250 }}ms">{% if de %}Bewertungen{% elsif ie %}Reviews{% elsif es %}Opiniones{% elsif pl %}Opinie{% else %}Recenzii{% endif %}<small>{{ rrating }} ★ · {{ rcount }}</small></a>
  </nav>
  {%- comment -%} v52: Herkunft mit SVG-Flagge statt "Handgefertigt in Italien" (nur DE/PL; RO-Zeile unverändert, ohne Italien) {%- endcomment -%}
  <div class="foot">{% if de %}{% render 'mia-italy', place: 'text' %} · <b>Echtes Leder</b> · 14 Tage Rückgabe{% elsif ie %}{% render 'mia-italy', place: 'text' %} · <b>Genuine leather</b> · 14-day returns{% elsif es %}{% render 'mia-italy', place: 'text' %} · <b>Piel auténtica</b> · Devolución en 14 días{% elsif pl %}{% render 'mia-italy', place: 'text' %} · <b>Skóra naturalna</b> · 14 dni na zwrot{% else %}Piele naturală · <b>Livrare gratuită peste 350 lei</b> · Retur 14 zile{% endif %}</div>
</div>
<script>
(function(){
  var T={% if de %}{av:'Auf Lager',so:'Ausverkauft',first:'Bald wieder da',see:'Diese Farbe ansehen →',see2:'Details ansehen →',legal:'inkl. MwSt., zzgl. Versand'}{% elsif ie %}{av:'In stock',so:'Sold out',first:'Back soon',see:'See this colour →',see2:'See details →',legal:'incl. VAT, plus delivery'}{% elsif es %}{av:'En stock',so:'Agotado',first:'Volverá pronto',see:'Ver este color →',see2:'Ver detalles →',legal:'IVA incluido · envío gratis'}{% elsif pl %}{av:'Dostępna',so:'Wyprzedane',first:'Wkrótce wróci',see:'Zobacz ten kolor →',see2:'Zobacz szczegóły →'}{% else %}{av:'În stoc · livrare în 1–2 zile',so:'Stoc epuizat',first:'Revine în curând',see:'Vezi această nuanță →',see2:'Vezi detalii →'}{% endif %};
  var m=document.getElementById('mdm');if(!m||m.__b)return;m.__b=1;
  var cards=[].slice.call(m.querySelectorAll('.card')),fan=m.querySelector('[data-mdm-fan]'),nameEl=m.querySelector('[data-mdm-name]'),priceEl=m.querySelector('[data-mdm-price]'),linkEl=m.querySelector('[data-mdm-link]');
  var N=cards.length,cur=0,open=false,step=12,stacked=true;
  function layout(){cards.forEach(function(c,i){var d=i-cur;var dc=Math.max(-3,Math.min(3,d));var r=stacked?0:dc*step;c.style.opacity=(open&&!stacked&&Math.abs(d)>3)?'0':'';var s=stacked?.92:(d===0?1:.96);c.style.transform='rotate('+r+'deg) scale('+s+')';c.style.zIndex=String(100-Math.abs(d));c.style.transitionDelay=stacked?'0ms':(Math.abs(d)*45)+'ms';c.classList.toggle('on',d===0);});
    var c=cards[cur];if(!c)return;nameEl.textContent=c.getAttribute('data-name');var av=c.getAttribute('data-avail')==='true';var cp=c.getAttribute('data-cmp');priceEl.innerHTML=av?((cp?'<s style="opacity:.6;margin-right:6px">'+cp+'</s>':'')+'<b>'+c.getAttribute('data-price')+'</b> · '+T.av+(T.legal?' · <span style="text-transform:none;letter-spacing:.02em">'+T.legal+'</span>':'')):('<b>'+T.so+'</b> · '+T.first);linkEl.href=c.getAttribute('data-url');linkEl.textContent=av?T.see:T.see2;}
  function show(){if(open)return;open=true;stacked=true;cur=Math.min(cur,N-1);layout();m.classList.add('open');m.setAttribute('aria-hidden','false');document.body.classList.add('mdm-lock');setTimeout(function(){stacked=false;layout();},120);}
  function hide(){if(!open)return;open=false;stacked=true;layout();m.classList.remove('open');m.setAttribute('aria-hidden','true');document.body.classList.remove('mdm-lock');}
  m.querySelector('[data-mdm-close]').addEventListener('click',hide);
  cards.forEach(function(c,i){c.addEventListener('click',function(e){if(i!==cur){e.preventDefault();cur=i;layout();}});});
  var sx=0,sy=0,moved=false;
  fan.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;sy=e.touches[0].clientY;moved=false;},{passive:true});
  fan.addEventListener('touchmove',function(e){var dx=e.touches[0].clientX-sx,dy=e.touches[0].clientY-sy;if(!moved&&Math.abs(dx)>28&&Math.abs(dx)>Math.abs(dy)){moved=true;cur=Math.max(0,Math.min(N-1,cur+(dx<0?1:-1)));layout();}},{passive:true});
  fan.addEventListener('click',function(e){if(moved){e.preventDefault();moved=false;}},true);
  document.addEventListener('click',function(e){var t=e.target&&e.target.closest?e.target.closest('.header--drawer-toggle'):null;if(!t)return;if(!window.matchMedia('(max-width:900px)').matches)return;e.preventDefault();e.stopImmediatePropagation();show();},true);
  document.addEventListener('keydown',function(e){if(e.key==='Escape')hide();});
  window.addEventListener('pageshow',function(){hide();});
  layout();
})();
</script>
